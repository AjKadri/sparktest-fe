// Native benchmark executable: 1,000,000 cases, prints failures and CPU ticks (macOS: 1,000,000 ticks = 1 s).
use std::io::Stdout
use sparktest::{check, Config, Outcome}
use sparktest_native::{fixed_seed, ticks}

pub fn main() -> i32 uses (out: mut Stdout) {
    let s = fixed_seed(99)
    let t0 = ticks()
    let o = check(Config::new(s).with_cases(1000000), |x: u256| x != s)
    let t1 = ticks()
    match o {
        Outcome::Pass { cases } => { println!("cases=", cases, " cpu_ticks=", t1 - t0) }
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _ } => { println!("unexpected failure") }
    }
    0
}
