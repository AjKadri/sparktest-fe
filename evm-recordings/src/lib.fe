// Recording ingot for the web demo (evm-recordings/). NOT part of test-all: the rec_* tests intentionally "fail" with a wrong
// expected selector so the runner prints the real PropertyFailed revert data, which scripts/record-evm.sh
// decodes with tools/decode-revert and stores in web/props.json as the "Recorded on EVM" panel.
use std::evm::Evm
use sparktest::{check, Config, Outcome}
use sparktest_evm::assert_holds

fn zero() -> u256 uses (evm: mut Evm) {
    if evm.chainid() == 0x1234567890abcdef {
        1
    } else {
        0
    }
}

#[test(should_revert, selector = 0xdeadbeef)]
fn rec_capped_mint() uses (evm: mut Evm) {
    assert_holds(
        check(
            Config::new(props::DEMO_SEED_CAPPED_MINT + zero()),
            props::prop_capped_mint,
        ),
    )
}

#[test(should_revert, selector = 0xdeadbeef)]
fn rec_buggy_sort() uses (evm: mut Evm) {
    assert_holds(
        check(
            Config::new(props::DEMO_SEED_BUGGY_SORT + zero()),
            props::prop_sorted,
        ),
    )
}

#[test(should_revert, selector = 0xdeadbeef)]
fn rec_pair_sum() uses (evm: mut Evm) {
    assert_holds(
        check(
