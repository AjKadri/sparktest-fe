#[test(should_revert, selector = 0xdeadbeef)]
fn rec_bank_sequence() uses (evm: mut Evm) {
    assert_holds(
        check(
            Config::new(props::DEMO_SEED_BANK + zero()),
            props::prop_bank_sequence,
        ),
    )
}

#[event]
struct Held { cases: u256, gas: u256 }

// the passing property: records how many cases ran and the gas they cost on sonatina
#[test]
fn rec_saturating_add() uses (evm: mut Evm) {
    let g0 = evm.gas()
    match check(
        Config::new(props::DEMO_SEED_SATURATING_ADD + zero()),
        props::prop_saturating_add,
    ) {
        Outcome::Pass { cases } => {
            evm.emit(Held { cases, gas: g0 - evm.gas() })
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            assert!(false)
        },
    }
}

// the fixed version with the same seed: records how many cases ran and the gas they cost
#[test]
fn rec_capped_mint_fixed() uses (evm: mut Evm) {
    let g0 = evm.gas()
    match check(
        Config::new(props::DEMO_SEED_CAPPED_MINT + zero()),
        props::prop_capped_mint_fixed,
    ) {
        Outcome::Pass { cases } => {
            evm.emit(Held { cases, gas: g0 - evm.gas() })
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            assert!(false)
        },
    }
}

