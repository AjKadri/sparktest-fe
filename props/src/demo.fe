use sparktest::{Seq, Index}

// Demo properties for the Sparktest web demo. Planted bugs, 64-bit-safe (inputs are u32 so they cross the wasm boundary).
// The text between `// @demo <name>` and `// @end` is shown verbatim in the demo page (extracted by scripts/build-demo.sh).

// @demo capped_mint
// A token with a supply cap. mint() must never let the supply exceed CAP.
pub const CAP: u64 = 1000

// BUG: the cap is checked against the supply BEFORE minting (`>=`), not against the supply AFTER
// minting (`new_supply > CAP`), so the last mint can overshoot the cap.
pub fn mint(_ supply: u64, _ amount: u64) -> u64 {
    if supply >= CAP { return supply }
    supply + amount
}

// Property: starting from any supply within the cap, minting any amount never exceeds the cap.
pub fn prop_capped_mint(_ p: (u32, u32)) -> bool {
    let supply = p.0 as u64
    if supply > CAP { return true }
    mint(supply, p.1 as u64) <= CAP
}
// @end

// @demo buggy_sort
// Sorts four numbers with bubble sort.
// BUG: sorting 4 elements needs 3 passes, this one stops after 2.
pub fn sort4(_ input: [u32; 4]) -> [u32; 4] {
    var a = input
    var pass: usize = 0
    while pass < 2 {
        var i: usize = 0
        while i < 3 {
            if a[i] > a[i + 1] {
                let t = a[i]
                a[i] = a[i + 1]
                a[i + 1] = t
            }
            i += 1
        }
        pass += 1
    }
    a
}

// Property: the output is sorted.
pub fn prop_sorted(_ input: [u32; 4]) -> bool {
    let o = sort4(input)
    o[0] <= o[1] && o[1] <= o[2] && o[2] <= o[3]
}
// @end

// @demo pair_sum
// Property: the sum of two numbers is below 10 (false for many inputs; the smallest is a sum of exactly 10).
// Sums are widened to u64 first so the property itself cannot overflow.
pub fn prop_pair_sum(_ p: (u32, u32)) -> bool {
    (p.0 as u64) + (p.1 as u64) < 10
}
// @end

// @demo saturating_add
// A property that holds: saturating addition never goes below its left operand.
pub fn prop_saturating_add(_ p: (u32, u32)) -> bool {
    p.0.saturating_add(p.1) >= p.0
}
// @end

// @demo bank_sequence
// A tiny bank with 3 accounts. A command is (kind, a, b, amount): kind 0 = deposit(a, amount), kind 1 = withdraw(a, amount)
// (takes at most the balance), kind 2 = transfer(a -> b, amount) (needs the balance, a != b).
// Invariant, checked after EVERY command: total deposited == sum of balances + total withdrawn.
pub struct Bank {
    pub bal: [u64; 3],
    pub drained: [bool; 3],
    pub deposited: u64,
    pub withdrawn: u64,
}

pub fn bank_new() -> Bank {
    Bank { bal: [0, 0, 0], drained: [false, false, false], deposited: 0, withdrawn: 0 }
}

pub fn bank_apply(_ bank: mut Bank, _ cmd: (Index<3>, Index<3>, Index<3>, u16)) {
    let kind = cmd.0.value
    let a = cmd.1.value
    let b = cmd.2.value
    let amount = cmd.3 as u64
    if kind == 0 {
        var credit = amount
        // BUG: after an account is drained to exactly 0, its next deposit is credited twice (the books still count it once).
        if bank.drained[a] {
            credit = amount * 2
            bank.drained[a] = false
        }
        bank.bal[a] += credit
        bank.deposited += amount
    } else if kind == 1 {
        let taken = if amount < bank.bal[a] { amount } else { bank.bal[a] }
        bank.bal[a] -= taken
        bank.withdrawn += taken
        if taken > 0 && bank.bal[a] == 0 {
            bank.drained[a] = true
        }
    } else {
        if a != b && bank.bal[a] >= amount {
            bank.bal[a] -= amount
            bank.bal[b] += amount
        }
    }
}

pub fn bank_consistent(_ bank: Bank) -> bool {
    bank.deposited == bank.bal[0] + bank.bal[1] + bank.bal[2] + bank.withdrawn
}

// Property: for every sequence of up to 8 commands, the invariant holds after every command.
pub fn prop_bank_sequence(_ s: Seq<(Index<3>, Index<3>, Index<3>, u16), 8>) -> bool {
    var bank = bank_new()
    var i: usize = 0
    while i < s.len {
        bank_apply(mut bank, s.items[i])
        if !bank_consistent(bank) { return false }
        i += 1
    }
    true
}
// @end

// @demo panic_overflow
// Property: multiplying by 1000 and dividing back gives x again.
// BUG: x * 1000 is computed in u64 and overflows (the code panics) for x >= 18446744073709552. A panic cannot be returned as false, so this property needs panic recovery.
pub fn prop_panic_overflow(_ x: u64) -> bool {
    x * 1000 / 1000 == x
}
// @end
