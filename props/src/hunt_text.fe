// L9 std hunt: core::text (decimal, hex, base64, base58, split, parse) round-trip and length laws. All predicted to pass (docs/EXPECTATIONS.md, "L9").
use core::ptr::MemBuffer
use core::text::{self, Text}
use core::fixed::Wad
use core::num::IntDowncast
use sparktest::Index

const E18: u256 = 1000000000000000000

fn pow10(_ e: usize) -> u256 {
    var r: u256 = 1
    var i: usize = 0
    while i < e {
        r *= 10
        i += 1
    }
    r
}

// numbers around every power of ten (10^k - 1, 10^k) are where the digit estimate in `decimal` can be off by one
fn around_powers_of_ten(_ base: u256, _ e: Index<78>, _ d: Index<3>) -> u256 {
    if d.value == 0 {
        base
    } else if d.value == 1 {
        pow10(e.value) - 1
    } else {
        pow10(e.value)
    }
}

pub fn prop_hunt_text_decimal_round_trip(_ p: (u256, Index<78>, Index<3>)) -> bool {
    let x = around_powers_of_ten(p.0, p.1, p.2)
    let s = text::decimal(x)
    match text::parse_uint(s) {
        Option::Some(v) => v == x,
        Option::None => false,
    }
}

pub fn prop_hunt_text_decimal_has_exactly_the_digits(_ p: (u256, Index<78>, Index<3>)) -> bool {
    let x = around_powers_of_ten(p.0, p.1, p.2)
    var n: usize = 1
    var rest = x / 10
    while rest > 0 {
        n += 1
        rest /= 10
    }
    let s = text::decimal(x)
    if s.text_len() != n {
        return false
    }
    var i: usize = 0
    while i < n {
        let c = s.text_byte(i)
        if c < 48 || c > 57 {
            return false
        }
        i += 1
    }
    // no leading zero except for the number zero itself
    n == 1 || s.text_byte(0) != 48
}

pub fn prop_hunt_text_hex_length_round_trip_and_case(_ p: (u256, Index<33>)) -> bool {
    let b = p.1.value
    let x = p.0
    let s = text::hex(x, b)
    let up = text::hex_upper(x, b)
    if s.text_len() != 2 * b || up.text_len() != 2 * b {
        return false
    }
    var i: usize = 0
    while i < 2 * b {
        let lc = s.text_byte(i)
        let want = if lc >= 97 && lc <= 102 { lc - 32 } else { lc }
        if up.text_byte(i) != want {
            return false
        }
        i += 1
    }
    if b == 0 { return true }
    let masked = if b == 32 {
        x
    } else {
        x & ((1 << (8 * b as u256)) - 1)
    }
    match text::parse_hex_uint(s) {
        Option::Some(v) => v == masked,
        Option::None => false,
    }
}

pub fn prop_hunt_text_decode_hex_gives_the_bytes(_ p: (u256, Index<33>)) -> bool {
    let b = p.1.value
    if b == 0 { return true }
    let s = text::hex(p.0, b)
    match text::decode_hex(s) {
        Option::Some(bytes) => {
            if bytes.len() != b {
                return false
            }
            var i: usize = 0
            while i < b {
                let want: u8 = ((p.0 >> (8 * ((b - 1 - i) as u256))) & 255).downcast_truncate()
                if bytes.byte_at(i) != want {
                    return false
                }
                i += 1
            }
            true
        },
        Option::None => false,
    }
}

fn buffer_of(_ data: [u8; 12], _ n: usize) -> MemBuffer {
    var buf = MemBuffer::new(n)
    var i: usize = 0
    while i < n {
        buf[i] = data[i]
        i += 1
    }
    buf
}

pub fn prop_hunt_text_base64_round_trip(_ p: ([u8; 12], Index<13>)) -> bool {
    let buf = buffer_of(p.0, p.1.value)
    let enc = text::base64(buf.span())
    match text::decode_base64(enc) {
        Option::Some(bytes) => bytes.span() == buf.span(),
        Option::None => false,
    }
}

// base58 keeps leading zero bytes as leading '1' characters: the arrays are zero-heavy (edge bias) so this is exercised
pub fn prop_hunt_text_base58_round_trip(_ p: ([u8; 12], Index<13>)) -> bool {
    let buf = buffer_of(p.0, p.1.value)
    let enc = text::base58(buf.span())
    match text::decode_base58(enc) {
        Option::Some(bytes) => bytes.span() == buf.span(),
        Option::None => false,
    }
}

// text over the alphabet {a, ',', b}: splitting by ',' and joining the parts back with ',' gives the text, and there is one part more than there are separators
pub fn prop_hunt_text_split_then_join_round_trips(_ p: ([u8; 12], Index<13>)) -> bool {
    var buf = MemBuffer::new(p.1.value)
    var commas: usize = 0
    var i: usize = 0
    while i < p.1.value {
        let m = p.0[i] % 3
        buf[i] = if m == 0 { 97 } else if m == 1 { 44 } else { 98 }
        if m == 1 { commas += 1 }
        i += 1
    }
    let span = buf.span()
    var joined = MemBuffer::new(0)
    var parts: usize = 0
    for part in span.by(span.split(b',')) {
        if parts > 0 {
            joined.push(b',')
        }
        joined.extend_from(part)
        parts += 1
    }
    parts == commas + 1 && joined.span() == span
}

pub fn prop_hunt_text_wad_parse_reads_what_decimal_wrote(_ p: (u64, u64)) -> bool {
    let whole = p.0 as u256
    let frac = (p.1 as u256) % E18
    var buf = MemBuffer::new(0)
    buf.extend_from(text::decimal(whole).span())
    buf.push(b'.')
    // exactly 18 fraction digits, zero padded on the left
    var scale = E18 / 10
    var k: usize = 0
    while k < 18 {
        let digit: u8 = ((frac / scale) % 10).downcast_truncate()
        buf.push(digit + 48)
        scale /= 10
        k += 1
    }
    match Wad::parse(buf.span()) {
        Option::Some(w) => {
            if w.raw() != whole * E18 + frac {
                return false
            }
        },
        Option::None => {
            return false
        },
    }
    // a 19th fraction digit is refused
    buf.push(b'0')
    match Wad::parse(buf.span()) {
        Option::Some(_) => false,
        Option::None => true,
    }
}
