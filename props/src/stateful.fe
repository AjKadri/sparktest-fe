// Stateful properties: sequences of commands, invariants checked after every command. Pure; run on every backend.
use sparktest::{Seq, Index}
use ingot::demo::{Bank, bank_new, bank_consistent}

// ---- Seq unit-test property ----
// "no two adjacent commands are equal" over Seq<Index<3>, 8>: false for most sequences; the minimum is two equal commands
pub fn prop_seq_no_adjacent_equal(_ s: Seq<Index<3>, 8>) -> bool {
    var i: usize = 1
    while i < s.len {
        if s.items[i - 1].value == s.items[i].value { return false }
        i += 1
    }
    true
}

// ---- the fixed bank (never doubles a deposit) ----
pub fn bank_apply_fixed(_ bank: mut Bank, _ cmd: (Index<3>, Index<3>, Index<3>, u16)) {
    let kind = cmd.0.value
    let a = cmd.1.value
    let b = cmd.2.value
    let amount = cmd.3 as u64
    if kind == 0 {
        bank.bal[a] += amount
        bank.deposited += amount
    } else if kind == 1 {
        let taken = if amount < bank.bal[a] { amount } else { bank.bal[a] }
        bank.bal[a] -= taken
        bank.withdrawn += taken
    } else {
        if a != b && bank.bal[a] >= amount {
            bank.bal[a] -= amount
            bank.bal[b] += amount
        }
    }
}

pub fn prop_bank_fixed(_ s: Seq<(Index<3>, Index<3>, Index<3>, u16), 8>) -> bool {
    var bank = bank_new()
    var i: usize = 0
    while i < s.len {
        bank_apply_fixed(mut bank, s.items[i])
        if !bank_consistent(bank) { return false }
        i += 1
    }
    true
}
