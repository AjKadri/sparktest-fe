// Native shim for Sparktest: prints failures with println! and then fails the test.
use std::io::Stdout
use std::abi::DynArray
use std::native::cpu_clock_ticks
use sparktest::{Outcome, Encode, Summary, Full}

// An optimizer-opaque zero: the CPU clock is an extern host call, so the compiler cannot know its value,
// and it is never this magic number (an unavailable clock reads -1).
pub fn opaque_zero() -> u256 {
    if cpu_clock_ticks() == -123456789 { 1 } else { 0 }
}

// Deterministic seed for tests (salt mixed with an opaque zero; same salt => same seed on every run).
pub fn fixed_seed(_ salt: u256) -> u256 {
    0x5eed5eed5eed5eed ^ salt ^ opaque_zero()
}

// Process CPU time in clock ticks (macOS: 1,000,000 per second).
pub fn ticks() -> i64 { cpu_clock_ticks() }

fn print_words(_ label: String<16>, _ w: [u256; 4]) uses (out: mut Stdout) {
    println!("XC ", label, "=", w[0], ",", w[1], ",", w[2], ",", w[3])
}

// Prints comparable lines:
//   XC <name> failed=<f> case=<c> steps=<s>
//   XC original=<w0>,<w1>,<w2>,<w3>
//   XC shrunk=<w0>,<w1>,<w2>,<w3>
pub fn print_summary(_ name: String<31>, _ s: Summary) uses (out: mut Stdout) {
    println!("XC ", name, " failed=", s.failed, " case=", s.case, " steps=", s.steps)
    print_words("original", s.original)
    print_words("shrunk", s.shrunk)
}

// Returns on Pass; on Fail prints seed, case, steps and the shrunk input words, then fails the test.
pub fn assert_holds<T: Encode + Copy>(_ outcome: Outcome<T>) uses (out: mut Stdout) {
    match outcome {
        Outcome::Pass { cases: _ } => {}
        Outcome::Fail { original: _, shrunk, case, seed, steps } => {
            println!("PROPERTY FAILED seed=", seed, " case=", case, " steps=", steps)
            let w = shrunk.words()
            var i: usize = 0
            while i < w.len() {
                let word: u256 = w.get(i)
                println!("  input word ", i as u256, " = ", word)
                i += 1
            }
            assert!(false)
        }
    }
}

fn print_all_words(_ label: String<16>, _ w: DynArray<u256>) uses (out: mut Stdout) {
    print!("XW ", label, "=")
    var i: usize = 0
    while i < w.len() {
        let word: u256 = w.get(i)
        if i > 0 { print!(",") }
        print!(word)
        i += 1
    }
    println!("")
}

// Prints a Full result: one header line, then the complete original and shrunk words (comma separated)
pub fn print_full(_ name: String<31>, _ f: Full) uses (out: mut Stdout) {
    println!("XW ", name, " failed=", f.failed, " case=", f.case, " steps=", f.steps)
    print_all_words("original", f.original)
    print_all_words("shrunk", f.shrunk)
}
