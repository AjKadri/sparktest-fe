// candidates: element 0's, then element 1's, ... (each with the others fixed)
impl<T: Shrink + Encode + Decode + Copy, const N: usize> Shrink for [T; N] {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        var j: usize = 0
        var rest = i
        while j < N {
            let n = count_candidates(self[j])
            if rest < n {
                match self[j].shrink_step(rest) {
                    Option::Some(e) => {
                        var out = self
                        out[j] = e
                        return Option::Some(out)
                    },
                    Option::None => {
                        return Option::None
