            }
            rest -= n
            j += 1
        }
        Option::None
    }
    // joint candidates (see joint.fe), tried by `check` after the element-wise candidates reach a fixed point
    fn joint_step(self, _ i: u256) -> Option<Self> {
        joint_candidate(self, i)
    }
}

