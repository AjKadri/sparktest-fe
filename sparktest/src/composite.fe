        rest -= na
        match b.shrink_step(rest) {
            Option::Some(b2) => Option::Some((a, b2)),
            Option::None => Option::None,
        }
    }
    fn joint_step(self, _ i: u256) -> Option<Self> {
        joint_candidate(self, i)
    }
}

