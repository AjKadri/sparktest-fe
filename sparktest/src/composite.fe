// number of shrink candidates of x (the runner walks candidates 0, 1, 2, .. until None)
pub fn count_candidates<T: Shrink + Copy>(_ x: T) -> u256 {
    var k: u256 = 0
    var more = true
    while more {
        match x.shrink_step(k) {
            Option::None => {
                more = false
            },
            Option::Some(_) => {
                k += 1
            },
        }
    }
    k
}

