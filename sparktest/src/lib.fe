// Sparktest core: pure, effect-free. No `uses (evm ...)` anywhere in this ingot.
use std::abi::{DynArray, dyn_array_from}
use core::ptr::MemVec
pub use checked::Checked
pub use index::Index
pub const MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
const MASK64: u256 = 0xffffffffffffffff

// ---- randomness ----
pub trait Rng {
    fn next(mut self) -> u256
}

// 64-bit xorshift on a u256 word
pub struct Xorshift { state: u256 }

impl Xorshift {
    pub fn seeded(_ seed: u256) -> Self {
        // fold the high bits in, never allow the all-zero state
        let s = (seed ^ (seed >> 64) ^ (seed >> 128) ^ (seed >> 192)) & MASK64
        Xorshift { state: if s == 0 { 0x9e3779b97f4a7c15 } else { s } }
    }
}

impl Rng for Xorshift {
    fn next(mut self) -> u256 {
        var x = self.state
        x = x ^ ((x << 13) & MASK64)
        x = x ^ (x >> 7)
        x = x ^ ((x << 17) & MASK64)
        self.state = x
        x
    }
}

// ---- traits ----
pub trait Arbitrary {
    fn arbitrary<R: Rng>(_ rng: mut R) -> Self
}

pub trait Shrink {
    // i-th shrink candidate (strictly simpler than self); None once candidates are exhausted
    fn shrink_step(self, _ i: u256) -> Option<Self>
}

// Encodes a value as a flat list of u256 words (ABI-ish), for reporting counterexamples of any size.
pub trait Encode {
    fn words(self) -> DynArray<u256>
}

pub fn one_word(_ w: u256) -> DynArray<u256> {
    dyn_array_from([w])
}

// appends every word of `src` to `out`
pub fn append_words(_ out: mut MemVec<u256>, _ src: DynArray<u256>) {
    var i: usize = 0
    while i < src.len() {
        out.push(src.get(i))
        i += 1
    }
}

// ---- u256 ----
fn full_word<R: Rng>(_ rng: mut R) -> u256 {
    let a = rng.next()
    let b = rng.next()
    let c = rng.next()
    let d = rng.next()
    a | (b << 64) | (c << 128) | (d << 192)
}

impl Arbitrary for u256 {
    fn arbitrary<R: Rng>(_ rng: mut R) -> Self {
        // about 1 in 4 draws is an edge value
        if rng.next() % 4 == 0 {
            let pick = rng.next() % 8
            let k = rng.next() % 256
            if pick == 0 { return 0 }
            if pick == 1 { return 1 }
            if pick == 2 { return 2 }
            if pick == 3 { return MAX }
            if pick == 4 { return MAX - 1 }
            let p = 1 << k
            if pick == 5 { return p }
            if pick == 6 { return p - 1 }
            return p + 1 // 2^k + 1 (k = 255 does not overflow)
        }
        full_word(mut rng)
    }
}

impl Shrink for u256 {
    // candidates: 0, then x - (x >> i) for i = 1.., then x - 1
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        if self == 0 { return Option::None }
        if i == 0 { return Option::Some(0) }
        if i < 256 {
            let d = self >> i
            if d == 0 {
                if (self >> (i - 1)) == 0 { return Option::None }
                return Option::Some(self - 1)
            }
            return Option::Some(self - d)
        }
        Option::None
    }
}

impl Encode for u256 {
    fn words(self) -> DynArray<u256> { one_word(self) }
}

// ---- bool ----
impl Arbitrary for bool {
    fn arbitrary<R: Rng>(_ rng: mut R) -> Self { rng.next() % 2 == 1 }
}

impl Shrink for bool {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        if self && i == 0 { return Option::Some(false) }
        Option::None
    }
}

impl Encode for bool {
    fn words(self) -> DynArray<u256> { one_word(if self { 1 } else { 0 }) }
}

// ---- runner ----
pub struct Config {
    pub cases: u256,
    pub seed: u256,
    pub max_shrinks: u256,
}

impl Config {
    // defaults: 256 cases, 1000 shrink steps
    pub fn new(_ seed: u256) -> Self {
        Config { cases: 256, seed, max_shrinks: 1000 }
    }
    pub fn with_cases(self, _ cases: u256) -> Self {
        Config { cases, seed: self.seed, max_shrinks: self.max_shrinks }
    }
    pub fn with_max_shrinks(self, _ max_shrinks: u256) -> Self {
        Config { cases: self.cases, seed: self.seed, max_shrinks }
    }
}

pub enum Outcome<T> {
    Pass { pub cases: u256 },
    Fail { pub original: T, pub shrunk: T, pub case: u256, pub seed: u256, pub steps: u256 },
}

pub fn check<T: Arbitrary + Shrink + Copy, P: Fn(T) -> bool>(_ cfg: Config, _ prop: P) -> Outcome<T> uses P::E {
    var rng = Xorshift::seeded(cfg.seed)
    var i: u256 = 0
    while i < cfg.cases {
        let x = <T as Arbitrary>::arbitrary(mut rng)
        if !prop(x) {
            // greedy shrink: first candidate that still fails, repeat
            var cur = x
            var steps: u256 = 0
            var progressed = true
            while progressed && steps < cfg.max_shrinks {
                progressed = false
                var k: u256 = 0
                var more = true
                while more {
                    match cur.shrink_step(k) {
                        Option::None => { more = false }
                        Option::Some(c) => {
                            if !prop(c) {
                                cur = c
                                steps += 1
                                progressed = true
                                more = false
                            } else {
                                k += 1
                            }
                        }
                    }
                }
            }
            return Outcome::Fail { original: x, shrunk: cur, case: i, seed: cfg.seed, steps }
        }
        i += 1
    }
    Outcome::Pass { cases: cfg.cases }
}

// ---- Summary: a flat, comparable view of an Outcome (used for cross-backend checks) ----
pub struct Summary {
    pub failed: u256,
    pub case: u256,
    pub steps: u256,
    pub original: [u256; 4],  // first 4 words of Encode::words(original)
    pub shrunk: [u256; 4],    // first 4 words of Encode::words(shrunk)
}

fn first4(_ w: DynArray<u256>) -> [u256; 4] {
    var out: [u256; 4] = [0, 0, 0, 0]
    var i: usize = 0
    while i < 4 && i < w.len() {
        out[i] = w.get(i)
        i += 1
    }
    out
}

pub fn summarize<T: Encode + Copy>(_ o: Outcome<T>) -> Summary {
    match o {
        Outcome::Pass { cases } => Summary { failed: 0, case: cases, steps: 0, original: [0, 0, 0, 0], shrunk: [0, 0, 0, 0] }
        Outcome::Fail { original, shrunk, case, seed: _, steps } => Summary { failed: 1, case, steps, original: first4(original.words()), shrunk: first4(shrunk.words()) }
    }
}
