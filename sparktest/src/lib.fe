// Sparktest core: pure, effect-free. No `uses (evm ...)` anywhere in this ingot.
use std::abi::{DynArray, dyn_array_from}
use core::ptr::MemVec
pub use checked::Checked
pub use index::Index
pub use seq::Seq
pub use joint::joint_candidate
pub use tally::{Tally, Verdict, guard, vacuity, VACUOUS_NO_CALLS, VACUOUS_NONE_SUCCEEDED, VACUOUS_KIND_BASE}
pub const MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
const MASK64: u256 = 0xffffffffffffffff

// ---- randomness ----
pub trait Rng {
    fn next(mut self) -> u256
}

// 64-bit xorshift on a u256 word
pub struct Xorshift { state: u256 }

impl Xorshift {
    pub fn seeded(_ seed: u256) -> Self {
        // fold the high bits in, never allow the all-zero state
        let s = (seed ^ (seed >> 64) ^ (seed >> 128) ^ (seed >> 192)) & MASK64
        Xorshift { state: if s == 0 { 0x9e3779b97f4a7c15 } else { s } }
    }
}

impl Rng for Xorshift {
    fn next(mut self) -> u256 {
        var x = self.state
        x = x ^ ((x << 13) & MASK64)
        x = x ^ (x >> 7)
        x = x ^ ((x << 17) & MASK64)
        self.state = x
        x
    }
}

// ---- traits ----
pub trait Arbitrary {
    fn arbitrary<R: Rng>(_ rng: mut R) -> Self
}

pub trait Shrink {
    // i-th shrink candidate (strictly simpler than self); None once candidates are exhausted
    fn shrink_step(self, _ i: u256) -> Option<Self>
    // i-th JOINT candidate (several components moved together; see joint.fe), tried by `check` only after no shrink_step candidate still fails;
    // None once exhausted. Scalars have none. Composites (tuples, arrays, Seq) implement it at the top level only, so nested ones cost nothing.
    fn joint_step(self, _ i: u256) -> Option<Self> { Option::None }
}

// Encodes a value as a flat list of u256 words (ABI-ish), for reporting counterexamples of any size.
pub trait Encode {
    fn words(self) -> DynArray<u256>
}

// The inverse of Encode: rebuilds a value from the words Encode produced. `decode` reads one value starting at word `pos`
// and returns it with the position after it (so composites can decode their parts in order). Not implemented for `Seq`.
pub trait Decode {
    fn decode(_ w: DynArray<u256>, _ pos: usize) -> (Self, usize)
    // Without allocating: if the words of `w` starting at `pos` are a valid encoding of one value (every word within the type's range),
    // returns the position after it, else 0. Joint shrinking uses it to test thousands of candidates without touching the heap
    // (sonatina never reclaims memory).
    fn fits(_ w: [u256; 64], _ pos: usize) -> usize
}

pub fn one_word(_ w: u256) -> DynArray<u256> {
    dyn_array_from([w])
}

// appends every word of `src` to `out`
pub fn append_words(_ out: mut MemVec<u256>, _ src: DynArray<u256>) {
    var i: usize = 0
    while i < src.len() {
        out.push(src.get(i))
        i += 1
    }
}

// ---- u256 ----
fn full_word<R: Rng>(_ rng: mut R) -> u256 {
    let a = rng.next()
    let b = rng.next()
    let c = rng.next()
    let d = rng.next()
    a | (b << 64) | (c << 128) | (d << 192)
}

impl Arbitrary for u256 {
    fn arbitrary<R: Rng>(_ rng: mut R) -> Self {
        // about 1 in 4 draws is an edge value
        if rng.next() % 4 == 0 {
            let pick = rng.next() % 8
            let k = rng.next() % 256
            if pick == 0 { return 0 }
            if pick == 1 { return 1 }
            if pick == 2 { return 2 }
            if pick == 3 { return MAX }
            if pick == 4 { return MAX - 1 }
            let p = 1 << k
            if pick == 5 { return p }
            if pick == 6 { return p - 1 }
            return p + 1 // 2^k + 1 (k = 255 does not overflow)
        }
        full_word(mut rng)
    }
}

impl Shrink for u256 {
    // candidates: 0, then x - (x >> i) for i = 1.., then x - 1
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        if self == 0 { return Option::None }
        if i == 0 { return Option::Some(0) }
        if i < 256 {
            let d = self >> i
            if d == 0 {
                if (self >> (i - 1)) == 0 { return Option::None }
                return Option::Some(self - 1)
            }
            return Option::Some(self - d)
        }
        Option::None
    }
}

impl Encode for u256 {
    fn words(self) -> DynArray<u256> { one_word(self) }
}

impl Decode for u256 {
    fn decode(_ w: DynArray<u256>, _ pos: usize) -> (Self, usize) { (w.get(pos), pos + 1) }
    fn fits(_ w: [u256; 64], _ pos: usize) -> usize { if pos < 64 { pos + 1 } else { 0 } }
}

// ---- bool ----
impl Arbitrary for bool {
    fn arbitrary<R: Rng>(_ rng: mut R) -> Self { rng.next() % 2 == 1 }
}

impl Shrink for bool {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        if self && i == 0 { return Option::Some(false) }
        Option::None
    }
}

impl Encode for bool {
    fn words(self) -> DynArray<u256> { one_word(if self { 1 } else { 0 }) }
}

impl Decode for bool {
    fn decode(_ w: DynArray<u256>, _ pos: usize) -> (Self, usize) { (w.get(pos) == 1, pos + 1) }
    fn fits(_ w: [u256; 64], _ pos: usize) -> usize { if pos < 64 && w[pos] <= 1 { pos + 1 } else { 0 } }
}

// ---- runner ----
pub struct Config {
    pub cases: u256,
    pub seed: u256,
    pub max_shrinks: u256,
}

impl Config {
    // defaults: 256 cases, 1000 shrink steps
    pub fn new(_ seed: u256) -> Self {
        Config { cases: 256, seed, max_shrinks: 1000 }
    }
    pub fn with_cases(self, _ cases: u256) -> Self {
        Config { cases, seed: self.seed, max_shrinks: self.max_shrinks }
    }
    pub fn with_max_shrinks(self, _ max_shrinks: u256) -> Self {
        Config { cases: self.cases, seed: self.seed, max_shrinks }
    }
}

pub enum Outcome<T> {
    Pass { pub cases: u256 },
    // `early` is true when shrinking was stopped before it finished because the `stop` closure of `check_with` said so (on the EVM:
    // remaining gas fell below the margin, see `sparktest_evm::check_gas`); `shrunk` is then the best input found so far, and it still fails.
    Fail { pub original: T, pub shrunk: T, pub case: u256, pub seed: u256, pub steps: u256, pub early: bool },
}

// Greedy shrinking in two phases that repeat while anything improves:
//   A. component candidates (`shrink_step`): the first candidate that still fails is taken, restart, until none fails (a fixed point);
//   B. joint candidates (`joint_step`), a finishing pass: the first one that still fails is taken, then back to A.
// `stop` is polled before every evaluation; when it says true the best input so far is returned with early = true.
// Returns (shrunk, accepted steps, stopped early).
fn shrink_loop<T: Shrink + Copy, P: Fn(T) -> bool, B: Fn() -> bool>(_ start: T, _ prop: P, _ max_shrinks: u256, _ stop: B) -> (T, u256, bool) uses (P::E, B::E) {
    var cur = start
    var steps: u256 = 0
    var early = false
    var improving = true
    while improving && steps < max_shrinks && !early {
        improving = false
        // phase A: component candidates to a fixed point
        var progressed = true
        while progressed && steps < max_shrinks && !early {
            progressed = false
            var k: u256 = 0
            var more = true
            while more {
                match cur.shrink_step(k) {
                    Option::None => { more = false }
                    Option::Some(c) => {
                        if stop() {
                            early = true
                            more = false
                        } else if !prop(c) {
                            cur = c
                            steps += 1
                            progressed = true
                            more = false
                        } else {
                            k += 1
                        }
                    }
                }
            }
        }
        // phase B: joint candidates, only once the component candidates are exhausted
        if steps < max_shrinks && !early {
            var j: u256 = 0
            var more = true
            while more {
                match cur.joint_step(j) {
                    Option::None => { more = false }
                    Option::Some(c) => {
                        if stop() {
                            early = true
                            more = false
                        } else if !prop(c) {
                            cur = c
                            steps += 1
                            improving = true
                            more = false
                        } else {
                            j += 1
                        }
                    }
                }
            }
        }
    }
    (cur, steps, early)
}

pub fn check<T: Arbitrary + Shrink + Copy, P: Fn(T) -> bool>(_ cfg: Config, _ prop: P) -> Outcome<T> uses P::E {
    check_with(cfg, prop, || false)
}

// `check` with a `stop` closure polled before every shrink evaluation (the core has no effects; the caller decides what "stop" means).
// sparktest_evm::check_gas passes "remaining gas is below the margin".
pub fn check_with<T: Arbitrary + Shrink + Copy, P: Fn(T) -> bool, B: Fn() -> bool>(_ cfg: Config, _ prop: P, _ stop: B) -> Outcome<T> uses (P::E, B::E) {
    var rng = Xorshift::seeded(cfg.seed)
    var i: u256 = 0
    while i < cfg.cases {
        let x = <T as Arbitrary>::arbitrary(mut rng)
        if !prop(x) {
            let (cur, steps, early) = shrink_loop(x, prop, cfg.max_shrinks, stop)
            return Outcome::Fail { original: x, shrunk: cur, case: i, seed: cfg.seed, steps, early }
        }
        i += 1
    }
    Outcome::Pass { cases: cfg.cases }
}

// ---- Summary: a flat, comparable view of an Outcome (used for cross-backend checks) ----
pub struct Summary {
    pub failed: u256,
    pub case: u256,
    pub steps: u256,
    pub original: [u256; 4],  // first 4 words of Encode::words(original)
    pub shrunk: [u256; 4],    // first 4 words of Encode::words(shrunk)
    pub early: u256,          // 1 = shrinking stopped early (gas), 0 = it finished
}

fn first4(_ w: DynArray<u256>) -> [u256; 4] {
    var out: [u256; 4] = [0, 0, 0, 0]
    var i: usize = 0
    while i < 4 && i < w.len() {
        out[i] = w.get(i)
        i += 1
    }
    out
}

pub fn summarize<T: Encode + Copy>(_ o: Outcome<T>) -> Summary {
    match o {
        Outcome::Pass { cases } => Summary { failed: 0, case: cases, steps: 0, original: [0, 0, 0, 0], shrunk: [0, 0, 0, 0], early: 0 }
        Outcome::Fail { original, shrunk, case, seed: _, steps, early } => Summary { failed: 1, case, steps, original: first4(original.words()), shrunk: first4(shrunk.words()), early: if early { 1 } else { 0 } }
    }
}

// ---- Full: an Outcome with the COMPLETE words of the original and shrunk inputs (Summary keeps only the first 4) ----
pub struct Full {
    pub failed: u256,
    pub case: u256,
    pub steps: u256,
    pub original: DynArray<u256>,
    pub shrunk: DynArray<u256>,
    pub early: u256,
}

pub fn full<T: Encode + Copy>(_ o: Outcome<T>) -> Full {
    match o {
        Outcome::Pass { cases } => Full { failed: 0, case: cases, steps: 0, original: DynArray::empty(), shrunk: DynArray::empty(), early: 0 }
        Outcome::Fail { original, shrunk, case, seed: _, steps, early } => Full { failed: 1, case, steps, original: original.words(), shrunk: shrunk.words(), early: if early { 1 } else { 0 } }
    }
}

// Shrinks a KNOWN failing input with the same greedy rule as `check` (first candidate that still fails, repeat; at most `max_shrinks` accepted steps).
// Returns the shrunk input and the number of accepted steps. Useful for tests and for replaying a reported counterexample.
pub fn shrink_input<T: Shrink + Copy, P: Fn(T) -> bool>(_ start: T, _ prop: P, _ max_shrinks: u256) -> (T, u256) uses P::E {
    let (cur, steps, _) = shrink_loop(start, prop, max_shrinks, || false)
    (cur, steps)
}
