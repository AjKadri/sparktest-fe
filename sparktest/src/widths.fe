        let p = 1 << k
        if pick == 5 { return p }
        if pick == 6 { return p - 1 }
        return p + 1
    }
    var v = rng.next()
    if bits > 64 {
        v = v | (rng.next() << 64)
    }
    if bits > 128 {
        v = v | (rng.next() << 128)
    }
    if bits > 192 {
        v = v | (rng.next() << 192)
    }
    v & top
}

