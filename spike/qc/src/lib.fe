use std::evm::Address
// Shared, effect-free core: PRNG + Arbitrary + Shrink + runner.
pub const MASK64: u256 = 0xffffffffffffffff

pub struct XorShift { pub state: u256 }
impl XorShift {
    pub fn new(_ seed: u256) -> Self { XorShift { state: (seed & MASK64) | 1 } }
    pub fn next(mut self) -> u256 {
        var x = self.state
        x = x ^ ((x << 13) & MASK64)
        x = x ^ (x >> 7)
        x = x ^ ((x << 17) & MASK64)
        self.state = x
        x
    }
}

pub trait Arbitrary {
    fn arbitrary(_ rng: mut XorShift) -> Self
}

pub trait Shrink {
    // i-th shrink candidate, strictly "smaller"; None when candidates are exhausted
    fn shrink_step(self, _ i: u256) -> Option<Self>
}

impl Arbitrary for u256 {
    fn arbitrary(_ rng: mut XorShift) -> Self { rng.next() % 100000 }
}

impl Shrink for u256 {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        if self == 0 { return Option::None }
        if i == 0 { return Option::Some(0) }
        if i < 256 {
            let d = self >> i
            if d == 0 {
                // halving candidates exhausted: x - 1 is the last candidate
                if i == 0 || (self >> (i - 1)) == 0 { return Option::None }
                return Option::Some(self - 1)
            }
            return Option::Some(self - d)
        }
        Option::None
    }
}

pub struct Outcome<T> {
    pub found: bool,
    pub input: T,       // minimal counterexample (valid only if found)
    pub first_case: u256,
    pub steps: u256,    // accepted shrink steps
    pub evals: u256,    // property evaluations during shrinking
}

pub fn run<T: Arbitrary + Shrink + Copy, P: Fn(T) -> bool>(_ prop: P, _ seed: u256, _ cases: u256, _ default: T) -> Outcome<T> uses P::E {
    var rng = XorShift::new(seed)
    var i: u256 = 0
    while i < cases {
        let x = T::arbitrary(mut rng)
        if !prop(x) {
            var cur = x
            var steps: u256 = 0
            var evals: u256 = 0
            var progressed = true
            while progressed {
                progressed = false
                var k: u256 = 0
                var more = true
                while more {
                    match cur.shrink_step(k) {
                        Option::None => { more = false }
                        Option::Some(c) => {
                            evals += 1
                            if !prop(c) {
                                cur = c
                                steps += 1
                                progressed = true
                                more = false
                            } else {
                                k += 1
                            }
                        }
                    }
                }
            }
            return Outcome { found: true, input: cur, first_case: i, steps, evals }
        }
        i += 1
    }
    Outcome { found: false, input: default, first_case: 0, steps: 0, evals: 0 }
}

// ---- E3: composites ----
pub fn count_candidates<T: Shrink + Copy>(_ x: T) -> u256 {
    var k: u256 = 0
    var more = true
    while more {
        match x.shrink_step(k) {
            Option::None => { more = false }
            Option::Some(_) => { k += 1 }
        }
    }
    k
}

impl<A: Arbitrary, B: Arbitrary> Arbitrary for (A, B) {
    fn arbitrary(_ rng: mut XorShift) -> Self {
        let a = A::arbitrary(mut rng)
        let b = B::arbitrary(mut rng)
        (a, b)
    }
}

// candidates: all of A's (B fixed), then all of B's (A fixed)
impl<A: Shrink + Copy, B: Shrink + Copy> Shrink for (A, B) {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        let (a, b) = self
        let na = count_candidates(a)
        if i < na {
            match a.shrink_step(i) {
                Option::Some(a2) => { return Option::Some((a2, b)) }
                Option::None => { return Option::None }
            }
        }
        match b.shrink_step(i - na) {
            Option::Some(b2) => Option::Some((a, b2))
            Option::None => Option::None
        }
    }
}

// ---- E3c: fixed arrays, generic over element type and length ----
impl<T: Arbitrary + Copy, const N: usize> Arbitrary for [T; N] {
    fn arbitrary(_ rng: mut XorShift) -> Self {
        var arr = [T::arbitrary(mut rng); N]
        var i: usize = 1
        while i < N {
            arr[i] = T::arbitrary(mut rng)
            i += 1
        }
        arr
    }
}

// candidates: element 0's candidates, then element 1's, ...
impl<T: Shrink + Copy, const N: usize> Shrink for [T; N] {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        var j: usize = 0
        var rest = i
        while j < N {
            let n = count_candidates(self[j])
            if rest < n {
                match self[j].shrink_step(rest) {
                    Option::Some(e) => {
                        var out = self
                        out[j] = e
                        return Option::Some(out)
                    }
                    Option::None => { return Option::None }
                }
            }
            rest -= n
            j += 1
        }
        Option::None
    }
}

impl Arbitrary for Address {
    fn arbitrary(_ rng: mut XorShift) -> Self { Address::from_word_truncate(rng.next() % 100000) }
}
impl Shrink for Address {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        match self.word().shrink_step(i) {
            Option::Some(w) => Option::Some(Address::from_word_truncate(w))
            Option::None => Option::None
        }
    }
}
