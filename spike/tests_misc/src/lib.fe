use std::evm::{Evm, revert_error}

#[error]
pub struct PropertyFailed { pub input: u256, pub case: u256 }

#[test(should_revert)]
fn r1_any_revert_passes() uses (evm: mut Evm) {
    revert_error(PropertyFailed { input: 51, case: 17 })
}

#[test(should_revert, selector = 0x30fd945a)]
fn r2_right_selector_passes() uses (evm: mut Evm) {
    revert_error(PropertyFailed { input: 51, case: 17 })
}

#[test(should_revert, selector = 0xdeadbeef)]
fn r3_wrong_selector_should_fail() uses (evm: mut Evm) {
    revert_error(PropertyFailed { input: 51, case: 17 })
}

#[test(should_revert)]
fn r4_no_revert_should_fail() {
}

#[test(should_revert, panic = 0x01)]
fn r5_assert_panic_passes() {
    assert!(false)
}

#[test(should_revert, input = 51)]
fn r6_payload_field_arg() uses (evm: mut Evm) {
    revert_error(PropertyFailed { input: 51, case: 17 })
}
