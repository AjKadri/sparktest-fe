// GENERATED by scripts/gen_erc20_tests.py -- do not edit by hand. Mutant M03 of the Fe Guide CoolCoin (see docs/EXPECTATIONS.md, L7a): results are recorded, not asserted.
use std::evm::{Evm, Address}
use std::abi::DynArray
use sparktest::{check, Config, Summary, summarize, Seq, Index, full, Tally, vacuity, guard, Verdict}
use sparktest_evm::fixed_seed
use coolcoin_mutants::m03::CoolCoinM03
use erc20_actors::actor::Actor
use erc20_actors::client::{total_supply, balance_of, allowance, actor_transfer, actor_approve, actor_transfer_from, mint, direct_transfer}

// 16 words: id, failed, case, steps, original[4], shrunk[4], gas, attempted, accepted, vacuous (0 = not vacuous, else the reason)
#[event]
struct Pr { id: u256, failed: u256, case: u256, steps: u256, o0: u256, o1: u256, o2: u256, o3: u256, s0: u256, s1: u256, s2: u256, s3: u256, gas: u256, attempted: u256, accepted: u256, vacuous: u256 }

fn emit_pr(_ id: u256, _ s: Summary, _ gas: u256, _ t: Tally, _ vac: u256) uses (evm: mut Evm) {
    evm.emit(Pr { id, failed: s.failed, case: s.case, steps: s.steps,
        o0: s.original[0], o1: s.original[1], o2: s.original[2], o3: s.original[3],
        s0: s.shrunk[0], s1: s.shrunk[1], s2: s.shrunk[2], s3: s.shrunk[3], gas,
        attempted: t.attempted, accepted: t.accepted, vacuous: vac })
}

// stateful event: first the head words, then the dynamic arrays: id, failed, case, steps, original, shrunk, gas, attempted, accepted, vacuous, then commands executed of kind 0..3
#[event]
struct Pw { id: u256, failed: u256, case: u256, steps: u256, original: DynArray<u256>, shrunk: DynArray<u256>, gas: u256, attempted: u256, accepted: u256, vacuous: u256, k0: u256, k1: u256, k2: u256, k3: u256 }

// four actor proxies (distinct msg.senders)
fn deploy_actors() -> [Address; 4] uses (evm: mut Evm) {
    let a0 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a1 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a2 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a3 = evm.create<Actor>(value: Wei::zero(), args: ())
    [a0, a1, a2, a3]
}

// a fresh token per case. The owner (who holds the MINTER role) is the test contract: supply 13, of which it sends 3 to each actor and keeps 1
// (so the setup never takes the owner's balance to exactly 0). A failing setup call reverts the whole test, which is visible, not a property result.
fn fresh_token(_ actors: [Address; 4]) -> Address uses (evm: mut Evm) {
    let token = evm.create<CoolCoinM03>(value: Wei::zero(), args: (13 as u256, evm.address()))
    assert!(direct_transfer(token, actors[0], 3))
    assert!(direct_transfer(token, actors[1], 3))
    assert!(direct_transfer(token, actors[2], 3))
    assert!(direct_transfer(token, actors[3], 3))
    token
}

fn who(_ actors: [Address; 4], _ i: Index<4>) -> Address { actors[i.value] }

fn sum_balances(_ token: Address, _ actors: [Address; 4]) -> u256 uses (evm: mut Evm) {
    balance_of(token, actors[0]) + balance_of(token, actors[1]) + balance_of(token, actors[2]) + balance_of(token, actors[3])
}

// P1: transfer(amount <= balance) succeeds and moves exactly amount (a self-transfer moves nothing)
fn p1(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, u16)) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    let from = who(actors, p.0)
    let to = who(actors, p.1)
    let bf = balance_of(token, from)
    let bt = balance_of(token, to)
    let amount = (p.2 as u256) % (bf + 1)
    let got = actor_transfer(from, token, to, amount)
    tally.call(got == 1)
    if got != 1 { return false }
    let af = balance_of(token, from)
    let at = balance_of(token, to)
    if p.0.value == p.1.value { return af == bf && at == bt }
    af == bf - amount && at == bt + amount
}

// P2: transfer(amount > balance) does not succeed and changes nothing
fn p2(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, u16)) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    let from = who(actors, p.0)
    let to = who(actors, p.1)
    let bf = balance_of(token, from)
    let bt = balance_of(token, to)
    let amount = bf + 1 + (p.2 as u256)
    let got = actor_transfer(from, token, to, amount)
    tally.call(got == 1)
    if got != 0 { return false }
    balance_of(token, from) == bf && balance_of(token, to) == bt && total_supply(token) == 13
}

// P3: transfers never change totalSupply (whether or not they succeed)
fn p3(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, u32)) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    let before = total_supply(token)
    let got = actor_transfer(who(actors, p.0), token, who(actors, p.1), p.2 as u256)
    tally.call(got == 1)
    total_supply(token) == before
}

// P4: approve then transferFrom(amount <= allowance): allowance drops by exactly amount, balances move exactly amount
// input: (owner, spender, to, packed) where allowance = packed % 65536 and the requested amount = packed / 65536
fn p4(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, Index<4>, u32)) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    let owner = who(actors, p.0)
    let spender = who(actors, p.1)
    let to = who(actors, p.2)
    let allowed = (p.3 % 65536) as u256
    let ap = actor_approve(owner, token, spender, allowed)
    tally.call(ap == 1)
    if ap != 1 { return false }
    let bo = balance_of(token, owner)
    let bt = balance_of(token, to)
    let cap = if allowed < bo { allowed } else { bo }
    let amount = ((p.3 / 65536) as u256) % (cap + 1)
    let got = actor_transfer_from(spender, token, owner, to, amount)
    tally.call(got == 1)
    if got != 1 { return false }
    if allowance(token, owner, spender) != allowed - amount { return false }
    if p.0.value == p.2.value { return balance_of(token, owner) == bo }
    balance_of(token, owner) == bo - amount && balance_of(token, to) == bt + amount
}

// P5: transferFrom(amount > allowance) does not succeed and leaves the allowance alone
fn p5(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, Index<4>, u32)) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    let owner = who(actors, p.0)
    let spender = who(actors, p.1)
    let to = who(actors, p.2)
    let allowed = (p.3 % 65536) as u256
    let ap = actor_approve(owner, token, spender, allowed)
    tally.call(ap == 1)
    if ap != 1 { return false }
    let amount = allowed + 1 + ((p.3 / 65536) as u256)
    let got = actor_transfer_from(spender, token, owner, to, amount)
    tally.call(got == 1)
    if got != 0 { return false }
    allowance(token, owner, spender) == allowed
}

// P6: conservation: after any transfer the four balances still add up to totalSupply
fn p6(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, u16)) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    let from = who(actors, p.0)
    let amount = (p.2 as u256) % (balance_of(token, from) + 1)
    let got = actor_transfer(from, token, who(actors, p.1), amount)
    tally.call(got == 1)
    sum_balances(token, actors) + balance_of(token, evm.address()) == total_supply(token)
}

#[test]
fn m03_p1_transfer_moves_exactly_amount() uses (evm: mut Evm) {
    let actors = deploy_actors()
    var tally = Tally::new()
    let g0 = evm.gas()
    let o = with (mut tally) { check(Config::new(fixed_seed(12003)).with_cases(64), |p: (Index<4>, Index<4>, u16)| p1(actors, p)) }
    let gas = g0 - evm.gas()
    let vac = vacuity(tally, true, 0)
    let s = summarize(o)
    emit_pr(4001, s, gas, tally, vac)
}

