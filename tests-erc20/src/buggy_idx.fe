    direct_transfer,
    actor_mint,
}

// 16 words: id, failed, case, steps, original[3], shrunk[5], gas, attempted, accepted, vacuous (0 = not vacuous, else the reason)
// (the shrunk input has 5 words since L7c, because P4's input is ((owner, spender, to), (allowance, amount)); an event holds at most 16 fields, so the
// original input keeps only its first 3 words)
#[event]
struct Pr {
    id: u256,
    failed: u256,
    case: u256,
    steps: u256,
    o0: u256,
    o1: u256,
    o2: u256,
    s0: u256,
    s1: u256,
    s2: u256,
    s3: u256,
    s4: u256,
    gas: u256,
    attempted: u256,
    accepted: u256,
    vacuous: u256,
}

fn wd(_ d: DynArray<u256>, _ i: usize) -> u256 {
    if i < d.len() { d.get(i) } else { 0 }
}

fn emit_pr(_ id: u256, _ s: Summary, _ f: Full, _ gas: u256, _ t: Tally, _ vac: u256)
uses (evm: mut Evm)
{
    evm.emit(
        Pr {
            id,
            failed: s.failed,
            case: s.case,
            steps: s.steps,
            o0: wd(f.original, 0),
            o1: wd(f.original, 1),
            o2: wd(f.original, 2),
            s0: wd(f.shrunk, 0),
            s1: wd(f.shrunk, 1),
            s2: wd(f.shrunk, 2),
            s3: wd(f.shrunk, 3),
            s4: wd(f.shrunk, 4),
            gas,
            attempted: t.attempted,
            accepted: t.accepted,
            vacuous: vac,
        },
    )
}

// first 4 head words, then the dynamic arrays: id, failed, case, steps, original, shrunk, gas, attempted, accepted, vacuous, then commands executed of kind 0..4, then 1 if shrinking was stopped early because gas ran low (check_gas), else 0
#[event]
struct Pw {
    id: u256,
    failed: u256,
    case: u256,
    steps: u256,
    original: DynArray<u256>,
    shrunk: DynArray<u256>,
    gas: u256,
    attempted: u256,
    accepted: u256,
    vacuous: u256,
    k0: u256,
    k1: u256,
    k2: u256,
    k3: u256,
    k4: u256,
    early: u256,
}

// four actor proxies (distinct msg.senders)
fn deploy_actors() -> [Address; 4] uses (evm: mut Evm) {
    let a0 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a1 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a2 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a3 = evm.create<Actor>(value: Wei::zero(), args: ())
    [a0, a1, a2, a3]
}

// a fresh token per case: supply 1000 to actor 0, which sends 250 to each other actor (every actor holds 250)
fn fresh_token(_ actors: [Address; 4]) -> Address uses (evm: mut Evm) {
    let token = evm.create<CoolCoin>(value: Wei::zero(), args: (1000 as u256, actors[0]))
    let _ = actor_transfer(actors[0], token, actors[1], 250)
    let _ = actor_transfer(actors[0], token, actors[2], 250)
    let _ = actor_transfer(actors[0], token, actors[3], 250)
    token
}

fn who(_ actors: [Address; 4], _ i: Index<4>) -> Address {
    actors[i.value]
}

fn sum_balances(_ token: Address, _ actors: [Address; 4]) -> u256
uses (evm: mut Evm)
{
    balance_of(token, actors[0])
        + balance_of(token, actors[1])
        + balance_of(token, actors[2])
        + balance_of(token, actors[3])
}

// P1: transfer(amount <= balance) succeeds and moves exactly amount (a self-transfer moves nothing)
fn p1(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, Index<251>)) -> bool
uses (evm: mut Evm, tally: mut Tally)
{
    let token = fresh_token(actors)
    let from = who(actors, p.0)
    let to = who(actors, p.1)
    let bf = balance_of(token, from)
    let bt = balance_of(token, to)
    let amount = p.2.value as u256
    let got = actor_transfer(from, token, to, amount)
    tally.call(got == 1)
    if got != 1 { return false }
    let af = balance_of(token, from)
    let at = balance_of(token, to)
    if p.0.value == p.1.value {
        return af == bf && at == bt
    }
    af == bf - amount && at == bt + amount
}

// P2: transfer(amount > balance) does not succeed and changes nothing
fn p2(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, u16)) -> bool
uses (evm: mut Evm, tally: mut Tally)
{
    let token = fresh_token(actors)
    let from = who(actors, p.0)
    let to = who(actors, p.1)
    let bf = balance_of(token, from)
    let bt = balance_of(token, to)
    let amount = bf + 1 + (p.2 as u256)
    let got = actor_transfer(from, token, to, amount)
    tally.call(got == 1)
    if got != 0 { return false }
    balance_of(token, from) == bf && balance_of(token, to) == bt && total_supply(token) == 1000
}

// P3: transfers never change totalSupply (whether or not they succeed)
fn p3(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, u32)) -> bool
uses (evm: mut Evm, tally: mut Tally)
{
    let token = fresh_token(actors)
    let before = total_supply(token)
    let got = actor_transfer(who(actors, p.0), token, who(actors, p.1), p.2 as u256)
    tally.call(got == 1)
    total_supply(token) == before
}

// P4: approve then transferFrom(amount <= allowance): allowance drops by exactly amount, balances move exactly amount
// input: ((owner, spender, to), (allowance, amount)): the amount is an Index, clamped to min(allowance, balance), so a counterexample shows the real amount
fn p4(_ actors: [Address; 4], _ p: ((Index<4>, Index<4>, Index<4>), (u16, Index<251>))) -> bool
uses (evm: mut Evm, tally: mut Tally)
{
    let token = fresh_token(actors)
    let owner = who(actors, p.0.0)
    let spender = who(actors, p.0.1)
    let to = who(actors, p.0.2)
    let allowed = p.1.0 as u256
    let ap = actor_approve(owner, token, spender, allowed)
    tally.call(ap == 1)
    if ap != 1 { return false }
    let bo = balance_of(token, owner)
    let bt = balance_of(token, to)
    let cap = if allowed < bo { allowed } else { bo }
    let want = p.1.1.value as u256
    let amount = if want < cap { want } else { cap }
    let got = actor_transfer_from(spender, token, owner, to, amount)
    tally.call(got == 1)
    if got != 1 { return false }
    if allowance(token, owner, spender) != allowed - amount {
        return false
    }
    if p.0.0.value == p.0.2.value {
        return balance_of(token, owner) == bo
    }
    balance_of(token, owner) == bo - amount && balance_of(token, to) == bt + amount
}

// P5: transferFrom(amount > allowance) does not succeed and leaves the allowance alone
fn p5(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, Index<4>, u32)) -> bool
uses (evm: mut Evm, tally: mut Tally)
{
    let token = fresh_token(actors)
    let owner = who(actors, p.0)
    let spender = who(actors, p.1)
    let to = who(actors, p.2)
    let allowed = (p.3 % 65536) as u256
    let ap = actor_approve(owner, token, spender, allowed)
    tally.call(ap == 1)
    if ap != 1 { return false }
    let amount = allowed + 1 + ((p.3 / 65536) as u256)
    let got = actor_transfer_from(spender, token, owner, to, amount)
    tally.call(got == 1)
    if got != 0 { return false }
    allowance(token, owner, spender) == allowed
}
// P6: conservation: after any transfer the four balances still add up to totalSupply
fn p6(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, Index<251>)) -> bool
uses (evm: mut Evm, tally: mut Tally)
{
    let token = fresh_token(actors)
    let from = who(actors, p.0)
    let amount = p.2.value as u256
    let got = actor_transfer(from, token, who(actors, p.1), amount)
    tally.call(got == 1)
    sum_balances(token, actors) == total_supply(token)
}

#[test]
fn buggyidx_p1_transfer_moves_exactly_amount() uses (evm: mut Evm) {
    let actors = deploy_actors()
    var tally = Tally::new()
    let g0 = evm.gas()
    let o = with (mut tally) {
        check(
            Config::new(fixed_seed(2807)).with_cases(64),
            |p: (Index<4>, Index<4>, Index<251>)| p1(actors, p),
        )
    }
    let gas = g0 - evm.gas()
    let vac = vacuity(tally, true, 0)
    let s = summarize(o)
    emit_pr(401, s, full(o), gas, tally, vac)
    // planted bug: must FAIL. Pre-registered minimum (original): (0, 0, 1); honest prediction (L4.1 amendment): (a, a, 1).
    // Asserted: a self-transfer (same actor) of amount 1. The exact indices are recorded in the event and in PROOF.md, not asserted.
    assert!(s.failed == 1)
    assert!(s.shrunk[0] == s.shrunk[1])
    assert!(s.shrunk[2] == 1)
}

#[test]
fn buggyidx_p2_transfer_over_balance_changes_nothing() uses (evm: mut Evm) {
    let actors = deploy_actors()
    var tally = Tally::new()
    let g0 = evm.gas()
    let o = with (mut tally) {
        check(
            Config::new(fixed_seed(2814)).with_cases(64),
            |p: (Index<4>, Index<4>, u16)| p2(actors, p),
        )
    }
    let gas = g0 - evm.gas()
    let vac = vacuity(tally, false, 0)
    let s = summarize(o)
    emit_pr(402, s, full(o), gas, tally, vac)
    assert!(s.failed == 0)
    assert!(s.case == 64)
    assert!(
        vac == 0,
    ) // the guard: the property really exercised its premise
    assert!(
        gas >= 64 * 20000,
    ) // proof of work: every case deploys a token and makes several calls
}

