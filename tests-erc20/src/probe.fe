// Probe: does `try_call` give the return data back, so a view like balanceOf can be read without reverting?
use std::evm::{Evm, Address}
use erc20_example::CoolCoin
use erc20_actors::client::Tok

#[test]
fn probe_try_call_returns_view_data() uses (evm: mut Evm) {
    let owner = Address::new(1)
    let token = evm.create<CoolCoin>(value: Wei::zero(), args: (1000 as u256, owner))
    let out = evm.try_call(addr: token, gas: 1000000, value: Wei::zero(), message: Tok::BalanceOf { account: owner })
    assert!(out.success())
    let balance: u256 = out.decode()      // CallOutcome::decode gives the typed return value
    assert!(balance == 1000)
    let r = evm.try_call(addr: token, gas: 1000000, value: Wei::zero(), message: Tok::TotalSupply {})
    let supply: u256 = r.decode()
    assert!(supply == 1000)
}
