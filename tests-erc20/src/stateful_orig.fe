// GENERATED by scripts/gen_erc20_tests.py -- do not edit by hand. Stateful: the UNCHANGED ERC20 test fixture against a pure reference model (expected to pass).
use std::evm::{Evm, Address}
use std::abi::DynArray
use sparktest::{check, Config, Summary, summarize, Seq, Index, full, Tally, vacuity, guard, Verdict}
use sparktest_evm::fixed_seed
use erc20_example::CoolCoin
use erc20_actors::actor::Actor
use erc20_actors::client::{total_supply, balance_of, allowance, actor_transfer, actor_approve, actor_transfer_from, mint, direct_transfer}

// 16 words: id, failed, case, steps, original[4], shrunk[4], gas, attempted, accepted, vacuous (0 = not vacuous, else the reason)
#[event]
struct Pr { id: u256, failed: u256, case: u256, steps: u256, o0: u256, o1: u256, o2: u256, o3: u256, s0: u256, s1: u256, s2: u256, s3: u256, gas: u256, attempted: u256, accepted: u256, vacuous: u256 }

fn emit_pr(_ id: u256, _ s: Summary, _ gas: u256, _ t: Tally, _ vac: u256) uses (evm: mut Evm) {
    evm.emit(Pr { id, failed: s.failed, case: s.case, steps: s.steps,
        o0: s.original[0], o1: s.original[1], o2: s.original[2], o3: s.original[3],
        s0: s.shrunk[0], s1: s.shrunk[1], s2: s.shrunk[2], s3: s.shrunk[3], gas,
        attempted: t.attempted, accepted: t.accepted, vacuous: vac })
}

// first 4 head words, then the dynamic arrays: id, failed, case, steps, original, shrunk, gas, attempted, accepted, vacuous, then commands executed of kind 0..3
#[event]
struct Pw { id: u256, failed: u256, case: u256, steps: u256, original: DynArray<u256>, shrunk: DynArray<u256>, gas: u256, attempted: u256, accepted: u256, vacuous: u256, k0: u256, k1: u256, k2: u256, k3: u256 }

// four actor proxies (distinct msg.senders)
fn deploy_actors() -> [Address; 4] uses (evm: mut Evm) {
    let a0 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a1 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a2 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a3 = evm.create<Actor>(value: Wei::zero(), args: ())
    [a0, a1, a2, a3]
}

// a fresh token per case: supply 16 to actor 0, which sends 4 to each other actor (every actor holds 4)
fn fresh_token(_ actors: [Address; 4]) -> Address uses (evm: mut Evm) {
    let token = evm.create<CoolCoin>(value: Wei::zero(), args: (16 as u256, actors[0]))
    let _ = actor_transfer(actors[0], token, actors[1], 4)
    let _ = actor_transfer(actors[0], token, actors[2], 4)
    let _ = actor_transfer(actors[0], token, actors[3], 4)
    token
}

fn who(_ actors: [Address; 4], _ i: Index<4>) -> Address { actors[i.value] }

fn sum_balances(_ token: Address, _ actors: [Address; 4]) -> u256 uses (evm: mut Evm) {
    balance_of(token, actors[0]) + balance_of(token, actors[1]) + balance_of(token, actors[2]) + balance_of(token, actors[3])
}


// A command is ((kind, a, b), (c, amount)): Index<4> actors and an Index<9> amount (0..8), so the shrinker sees the real values.
//   kind 0: Transfer      from a  to b
//   kind 1: Approve       owner a spender b
//   kind 2: TransferFrom  spender a, owner b, to c
//   kind 3: Mint          to a
// Reference model: balances, allowances (owner * 4 + spender), totalSupply. Calls and command kinds are counted for the vacuity guard.
fn run_sequence(_ actors: [Address; 4], _ s: Seq<((Index<4>, Index<4>, Index<4>), (Index<4>, Index<9>)), 8>) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    var bal: [u256; 4] = [4, 4, 4, 4]
    var allow: [u256; 16] = [0; 16]
    var supply: u256 = 16
    var i: usize = 0
    while i < s.len {
        let cmd = s.items[i]
        let kind = cmd.0.0.value
        let a = cmd.0.1.value
        let b = cmd.0.2.value
        let c = cmd.1.0.value
        let amount = cmd.1.1.value as u256
        tally.command(kind)
        var touched_o: usize = 0
        var touched_s: usize = 0
        if kind == 0 {
            let expect = bal[a] >= amount
            let got = actor_transfer(actors[a], token, actors[b], amount)
            tally.call(got == 1)
            if (got == 1) != expect { return false }
            if expect {
                bal[a] -= amount
                bal[b] += amount
            }
        } else if kind == 1 {
            let ap = actor_approve(actors[a], token, actors[b], amount)
            tally.call(ap == 1)
            if ap != 1 { return false }
            allow[a * 4 + b] = amount
            touched_o = a
            touched_s = b
        } else if kind == 2 {
            let allowed = allow[b * 4 + a]
            let expect = allowed >= amount && bal[b] >= amount
            let got = actor_transfer_from(actors[a], token, actors[b], actors[c], amount)
            tally.call(got == 1)
            if (got == 1) != expect { return false }
            if expect {
                allow[b * 4 + a] -= amount
                bal[b] -= amount
                bal[c] += amount
            }
            touched_o = b
            touched_s = a
        } else {
            let ok = mint(token, actors[a], amount)
            tally.call(ok)
            if !ok { return false }
            supply += amount
            bal[a] += amount
        }
        // after EVERY call: the contract equals the model, and the balances add up to totalSupply
        var sum: u256 = 0
        var k: usize = 0
        while k < 4 {
            let onchain = balance_of(token, actors[k])
            if onchain != bal[k] { return false }
            sum += onchain
            k += 1
        }
        
        if total_supply(token) != supply { return false }
        if sum != supply { return false }
        if allowance(token, actors[touched_o], actors[touched_s]) != allow[touched_o * 4 + touched_s] { return false }
        i += 1
    }
    true
}

#[test]
fn stateful_orig() uses (evm: mut Evm) {
    let actors = deploy_actors()
    var tally = Tally::new()
    let g0 = evm.gas()
    let o = with (mut tally) { check(Config::new(9001 + zero()).with_cases(64), |s: Seq<((Index<4>, Index<4>, Index<4>), (Index<4>, Index<9>)), 8>| run_sequence(actors, s)) }
    let gas = g0 - evm.gas()
    let vac = vacuity(tally, true, 4)
    let f = full(o)
    let seq_len: u256 = if f.failed == 1 { f.shrunk.get(0) } else { 0 }
    evm.emit(Pw { id: 601, failed: f.failed, case: f.case, steps: f.steps, original: f.original, shrunk: f.shrunk, gas,
        attempted: tally.attempted, accepted: tally.accepted, vacuous: vac, k0: tally.kinds[0], k1: tally.kinds[1], k2: tally.kinds[2], k3: tally.kinds[3] })
    assert!(f.failed == 0)
    assert!(f.case == 64)
    assert!(vac == 0)            // the guard: every command kind ran and some call succeeded
    assert!(gas >= 64 * 50000)   // proof of work: every case deploys a token and replays up to 8 commands with model checks after each
}

fn zero() -> u256 uses (evm: mut Evm) {
    if evm.chainid() == 0x1234567890abcdef { 1 } else { 0 }
}
