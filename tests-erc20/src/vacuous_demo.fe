// GENERATED by scripts/gen_erc20_tests.py -- do not edit by hand. Vacuity guard demo: a conditional property whose condition never holds passes unguarded and is reported VACUOUS with the guard.
use std::evm::{Evm, Address}
use std::abi::DynArray
use sparktest::{check, Config, Summary, summarize, Full, Seq, Index, full, Tally, vacuity, guard, Verdict}
use sparktest_evm::{fixed_seed, check_gas}
use erc20_example::CoolCoin
use erc20_actors::actor::Actor
use erc20_actors::client::{total_supply, balance_of, allowance, actor_transfer, actor_approve, actor_transfer_from, mint, direct_transfer, actor_mint}

// 16 words: id, failed, case, steps, original[3], shrunk[5], gas, attempted, accepted, vacuous (0 = not vacuous, else the reason)
// (the shrunk input has 5 words since L7c, because P4's input is ((owner, spender, to), (allowance, amount)); an event holds at most 16 fields, so the
// original input keeps only its first 3 words)
#[event]
struct Pr { id: u256, failed: u256, case: u256, steps: u256, o0: u256, o1: u256, o2: u256, s0: u256, s1: u256, s2: u256, s3: u256, s4: u256, gas: u256, attempted: u256, accepted: u256, vacuous: u256 }

fn wd(_ d: DynArray<u256>, _ i: usize) -> u256 { if i < d.len() { d.get(i) } else { 0 } }

fn emit_pr(_ id: u256, _ s: Summary, _ f: Full, _ gas: u256, _ t: Tally, _ vac: u256) uses (evm: mut Evm) {
    evm.emit(Pr { id, failed: s.failed, case: s.case, steps: s.steps,
        o0: wd(f.original, 0), o1: wd(f.original, 1), o2: wd(f.original, 2),
        s0: wd(f.shrunk, 0), s1: wd(f.shrunk, 1), s2: wd(f.shrunk, 2), s3: wd(f.shrunk, 3), s4: wd(f.shrunk, 4), gas,
        attempted: t.attempted, accepted: t.accepted, vacuous: vac })
}

// first 4 head words, then the dynamic arrays: id, failed, case, steps, original, shrunk, gas, attempted, accepted, vacuous, then commands executed of kind 0..4, then 1 if shrinking was stopped early because gas ran low (check_gas), else 0
#[event]
struct Pw { id: u256, failed: u256, case: u256, steps: u256, original: DynArray<u256>, shrunk: DynArray<u256>, gas: u256, attempted: u256, accepted: u256, vacuous: u256, k0: u256, k1: u256, k2: u256, k3: u256, k4: u256, early: u256 }

// four actor proxies (distinct msg.senders)
fn deploy_actors() -> [Address; 4] uses (evm: mut Evm) {
    let a0 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a1 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a2 = evm.create<Actor>(value: Wei::zero(), args: ())
    let a3 = evm.create<Actor>(value: Wei::zero(), args: ())
    [a0, a1, a2, a3]
}

// a fresh token per case: supply 1000 to actor 0, which sends 250 to each other actor (every actor holds 250)
fn fresh_token(_ actors: [Address; 4]) -> Address uses (evm: mut Evm) {
    let token = evm.create<CoolCoin>(value: Wei::zero(), args: (1000 as u256, actors[0]))
    let _ = actor_transfer(actors[0], token, actors[1], 250)
    let _ = actor_transfer(actors[0], token, actors[2], 250)
    let _ = actor_transfer(actors[0], token, actors[3], 250)
    token
}

fn who(_ actors: [Address; 4], _ i: Index<4>) -> Address { actors[i.value] }

fn sum_balances(_ token: Address, _ actors: [Address; 4]) -> u256 uses (evm: mut Evm) {
    balance_of(token, actors[0]) + balance_of(token, actors[1]) + balance_of(token, actors[2]) + balance_of(token, actors[3])
}

// "if the transfer succeeds, it moves exactly the amount" with EVERY amount above the balance: the transfer never succeeds, so the property can never fail
fn vacuous_p1(_ actors: [Address; 4], _ p: (Index<4>, Index<4>, u16)) -> bool uses (evm: mut Evm, tally: mut Tally) {
    let token = fresh_token(actors)
    let from = who(actors, p.0)
    let to = who(actors, p.1)
    let bf = balance_of(token, from)
    let bt = balance_of(token, to)
    let amount = bf + 1 + (p.2 as u256)
    let got = actor_transfer(from, token, to, amount)
    tally.call(got == 1)
    if got == 1 {
        if p.0.value == p.1.value { return balance_of(token, from) == bf }
        return balance_of(token, from) == bf - amount && balance_of(token, to) == bt + amount
    }
    true
}

#[test]
fn vacuous_property_passes_unguarded_and_is_reported_vacuous() uses (evm: mut Evm) {
    let actors = deploy_actors()
    var tally = Tally::new()
    let g0 = evm.gas()
    let o = with (mut tally) { check(Config::new(fixed_seed(700)).with_cases(64), |p: (Index<4>, Index<4>, u16)| vacuous_p1(actors, p)) }
    let gas = g0 - evm.gas()
    let s = summarize(o)
    let vac = vacuity(tally, true, 0)
    emit_pr(701, s, full(o), gas, tally, vac)
    // unguarded: a plain Pass (the property can never fail)
    assert!(s.failed == 0 && s.case == 64)
    // guarded: 64 calls attempted, none succeeded -> vacuous (reason 2: no call succeeded)
    assert!(tally.attempted == 64 && tally.accepted == 0)
    assert!(vac == 2)
    match guard(o, tally, true, 0) {
        Verdict::Vacuous { reason } => { assert!(reason == 2) }
        Verdict::Held => { assert!(false) }
        Verdict::Failed => { assert!(false) }
    }
}
