// Bank model tests (sonatina): the planted bug needs 3 commands; the fixed bank passes.
use std::evm::Evm
use sparktest::{check, Config, Outcome}
use sparktest_evm::fixed_seed

#[test]
fn bank_bug_is_found_and_shrunk_to_three_commands() uses (evm: mut Evm) {
    match check(
        Config::new(fixed_seed(960)).with_cases(512),
        props::prop_bank_sequence,
    ) {
        Outcome::Pass { cases: _ } => {
            assert!(false)
        },
        Outcome::Fail { original, shrunk, case: _, seed: _, steps: _, early: _ } => {
            assert!(original.len > 3)
            assert!(shrunk.len == 3)
            // deposit, withdraw, deposit; amounts 1; one account throughout; the unused `b` is 0
            assert!(
                shrunk.items[0].0.value == 0
                    && shrunk.items[1].0.value == 1
                    && shrunk.items[2].0.value == 0,
            )
            assert!(
                shrunk.items[0].3 == 1 && shrunk.items[1].3 == 1 && shrunk.items[2].3 == 1,
            )
            assert!(
                shrunk.items[0].1.value == shrunk.items[1].1.value
                    && shrunk.items[1].1.value == shrunk.items[2].1.value,
            )
            assert!(
                shrunk.items[0].2.value == 0
                    && shrunk.items[1].2.value == 0
                    && shrunk.items[2].2.value == 0,
            )
        },
    }
}

#[test]
fn bank_fixed_passes() uses (evm: mut Evm) {
    let g0 = evm.gas()
    match check(Config::new(fixed_seed(961)), props::prop_bank_fixed) {
        Outcome::Pass { cases } => {
            assert!(cases == 256)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            assert!(false)
        },
    }
    assert!(
        g0 - evm.gas() >= 256 * 5000,
    ) // proof of work: every case runs up to 8 commands
}
