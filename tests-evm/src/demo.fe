// panic_overflow: the buggy version panics (see tests-isolated); the fixed version widens to u128 and passes the same seed; gas proves the cases ran
#[test]
fn demo_panic_overflow_fixed_passes() uses (evm: mut Evm) {
    let g0 = evm.gas()
    match check(
        Config::new(fixed_seed(8101)),
        props::prop_panic_overflow_fixed,
    ) {
        Outcome::Pass { cases } => {
            assert!(cases == 256)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            assert!(false)
        },
    }
    assert!(g0 - evm.gas() >= 256 * 50)
}
