// ---- d) std::evm::random (sonatina only: `std::evm` has no native backend) ----
use std::evm::random::{KeccakRng, Rng, shuffle}
use sparktest::Index

// the same seed gives the same stream, and different seeds give different first words
fn rng_deterministic(_ seed: u256) -> bool {
    var a = KeccakRng::seeded(seed)
    var b = KeccakRng::seeded(seed)
    var i: usize = 0
    while i < 8 {
        if a.next() != b.next() { return false }
        i += 1
    }
    true
}

fn rng_seeds_differ(_ p: (u256, u256)) -> bool {
    if p.0 == p.1 { return true }
    var a = KeccakRng::seeded(p.0)
    var b = KeccakRng::seeded(p.1)
    a.next() != b.next()
}

fn rng_uniform_in_range(_ p: (u256, u256)) -> bool {
    let upper = if p.1 == 0 { 1 } else { p.1 }
    var r = KeccakRng::seeded(p.0)
    var i: usize = 0
    while i < 8 {
        if r.uniform(upper) >= upper { return false }
        i += 1
    }
    true
}

fn rng_chance_bounds(_ p: (u256, u256)) -> bool {
    let d = if p.1 == 0 { 1 } else { p.1 }
    var r = KeccakRng::seeded(p.0)
    var i: usize = 0
    while i < 8 {
        if r.chance(numerator: 0, denominator: d) { return false }
        if !r.chance(numerator: d, denominator: d) { return false }
        i += 1
    }
    true
}

// shuffle returns a permutation: the multiset is unchanged
fn rng_shuffle_is_a_permutation(_ p: (u256, [u8; 8])) -> bool {
    var items = p.1
    var r = KeccakRng::seeded(p.0)
    with (Rng = r) { shuffle(mut items) }
    var i: usize = 0
    while i < 8 {
        var want: usize = 0
        var have: usize = 0
        var j: usize = 0
        while j < 8 {
            if p.1[j] == p.1[i] { want += 1 }
            if items[j] == p.1[i] { have += 1 }
            j += 1
        }
        if want != have { return false }
        i += 1
    }
    true
}

#[test]
fn hunt_d_rng_same_seed_same_stream() uses (evm: mut Evm) {
    assert!(summarize(check(Config::new(fixed_seed(9401)).with_cases(64), rng_deterministic)).failed == 0)
}

#[test]
fn hunt_d_rng_different_seeds_differ() uses (evm: mut Evm) {
    assert!(summarize(check(Config::new(fixed_seed(9402)).with_cases(64), rng_seeds_differ)).failed == 0)
}

#[test]
fn hunt_d_rng_uniform_is_below_upper() uses (evm: mut Evm) {
    assert!(summarize(check(Config::new(fixed_seed(9403)).with_cases(64), rng_uniform_in_range)).failed == 0)
}

#[test]
fn hunt_d_rng_chance_bounds() uses (evm: mut Evm) {
    assert!(summarize(check(Config::new(fixed_seed(9404)).with_cases(64), rng_chance_bounds)).failed == 0)
}

#[test]
fn hunt_d_rng_shuffle_is_a_permutation() uses (evm: mut Evm) {
    assert!(summarize(check(Config::new(fixed_seed(9405)).with_cases(64), rng_shuffle_is_a_permutation)).failed == 0)
}
