// L2 step 6 PROBE: can a test observe a contract's panic as a value, without reverting the test itself,
// and can check() shrink a counterexample found through a contract call?
use std::abi::sol
use std::evm::{Evm, Call, Address}
use qc::{check, Config, Outcome}
use qc_evm::fixed_seed

msg AdderMsg {
    #[selector = sol("addU8(uint8,uint8)")]
    AddU8 { a: u8, b: u8 } -> u8,
}

// Panics (checked overflow, Panic(0x11)) whenever a + b > 255.
pub contract Adder {
    init() {}

    recv AdderMsg {
        AddU8 { a, b } -> u8 {
            a + b
        }
    }
}

#[event]
struct CallGas { ok_gas: u256, revert_gas: u256, revert_len: u256 }

#[test]
fn probe_revert_comes_back_as_a_value() uses (evm: mut Evm) {
    let addr = evm.create2<Adder>(value: Wei::zero(), args: (), salt: 1)

    let g0 = evm.gas()
    let ok = evm.try_call(addr: addr, gas: 100000, value: Wei::zero(), message: AdderMsg::AddU8 { a: 100, b: 100 })
    let g1 = evm.gas()
    let bad = evm.try_call(addr: addr, gas: 100000, value: Wei::zero(), message: AdderMsg::AddU8 { a: 200, b: 100 })
    let g2 = evm.gas()

    assert!(ok.success())          // 100 + 100 = 200 fits
    assert!(!bad.success())        // 200 + 100 overflows: the contract reverted, our test did not
    evm.emit(CallGas { ok_gas: g0 - g1, revert_gas: g1 - g2, revert_len: bad.returndata().len() as u256 })
}

#[test]
fn probe_check_shrinks_through_contract_call() uses (evm: mut Evm) {
    let addr = evm.create2<Adder>(value: Wei::zero(), args: (), salt: 2)
    let o = check(Config::new(fixed_seed(300)).with_cases(64), |p: (u8, u8)| {
        evm.try_call(addr: addr, gas: 100000, value: Wei::zero(), message: AdderMsg::AddU8 { a: p.0, b: p.1 }).success()
    })
    match o {
        Outcome::Pass { cases: _ } => { assert!(false) }
        Outcome::Fail { original, shrunk, case: _, seed: _, steps: _ } => {
            // minimal failing sums are exactly 256
            assert!((original.0 as u256) + (original.1 as u256) > 255)
            assert!((shrunk.0 as u256) + (shrunk.1 as u256) == 256)
        }
    }
}

// observable shrunk value + gas of the whole contract-backed check (CallGas-like event)
#[event]
struct ShrunkViaContract { a: u256, b: u256, steps: u256, gas: u256 }

#[test]
fn probe_check_via_contract_reports_shrunk_and_gas() uses (evm: mut Evm) {
    let addr = evm.create2<Adder>(value: Wei::zero(), args: (), salt: 3)
    let g0 = evm.gas()
    let o = check(Config::new(fixed_seed(300)).with_cases(64), |p: (u8, u8)| {
        evm.try_call(addr: addr, gas: 100000, value: Wei::zero(), message: AdderMsg::AddU8 { a: p.0, b: p.1 }).success()
    })
    let gas = g0 - evm.gas()
    match o {
        Outcome::Pass { cases: _ } => { assert!(false) }
        Outcome::Fail { original: _, shrunk, case: _, seed: _, steps } => {
            evm.emit(ShrunkViaContract { a: shrunk.0 as u256, b: shrunk.1 as u256, steps, gas })
        }
    }
}
