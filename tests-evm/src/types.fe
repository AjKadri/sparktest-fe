// L1 tests: one passing and one failing property per type; every seed is fixed via fixed_seed(salt).
use std::evm::{Evm, Address}
use std::abi::DynArray
use qc::{check, Config, Outcome, Arbitrary, Shrink, Encode}
use qc_evm::{assert_holds, fixed_seed}

fn is_pass<T>(_ o: Outcome<T>) -> bool {
    match o {
        Outcome::Pass { cases: _ } => true
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _ } => false
    }
}

fn shrunk_of<T: Copy>(_ o: Outcome<T>, _ d: T) -> T {
    match o {
        Outcome::Pass { cases: _ } => d
        Outcome::Fail { original: _, shrunk, case: _, seed: _, steps: _ } => shrunk
    }
}

fn case_of<T>(_ o: Outcome<T>) -> u256 {
    match o {
        Outcome::Pass { cases } => cases
        Outcome::Fail { original: _, shrunk: _, case, seed: _, steps: _ } => case
    }
}

// ---- u8 ----
#[test]
fn u8_passing_property() uses (evm: mut Evm) {
    let g0 = evm.gas()
    let o = check(Config::new(fixed_seed(20)), |x: u8| (x as u256) <= 255)
    assert!(is_pass(o))
    assert!(case_of(o) == 256)
    // proof the cases actually ran: gas used is at least 50 per case
    assert!(g0 - evm.gas() >= 256 * 50)
}

// x < 200 fails; the minimal counterexample is exactly 200
#[test]
fn u8_failing_property_shrinks_to_minimum() uses (evm: mut Evm) {
    let o = check(Config::new(fixed_seed(21)), |x: u8| (x as u256) < 200)
    assert!(!is_pass(o))
    assert!((shrunk_of(o, 0) as u256) == 200)
}

// edge bias: the max value is found within 256 cases
#[test]
fn u8_edge_bias_finds_max() uses (evm: mut Evm) {
    let max: u8 = 255
    let o = check(Config::new(fixed_seed(22)), |x: u8| x != max)
    assert!(!is_pass(o))
    assert!(case_of(o) < 256)
    assert!(shrunk_of(o, 0) == max)
}

