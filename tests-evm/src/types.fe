// ---- Address ----
#[test]
fn address_passing_property() uses (evm: mut Evm) {
    let g0 = evm.gas()
    let o = check(Config::new(fixed_seed(40)), |a: Address| a.word() < 1461501637330902918203684832716283019655932542976) // < 2^160
    assert!(is_pass(o))
    assert!(g0 - evm.gas() >= 256 * 50)
}

// word(a) < 0x1000 fails; minimal counterexample is the address 0x1000
#[test]
fn address_failing_property_shrinks_to_minimum() uses (evm: mut Evm) {
    let o = check(Config::new(fixed_seed(41)), |a: Address| a.word() < 0x1000)
    assert!(!is_pass(o))
    assert!(shrunk_of(o, Address::zero()).word() == 0x1000)
}

// edge bias: the max address (2^160 - 1) and the zero address are found
#[test]
fn address_edge_bias_finds_max_and_zero() uses (evm: mut Evm) {
    let max = Address::from_word_truncate(1461501637330902918203684832716283019655932542975)
    let o = check(Config::new(fixed_seed(42)), |a: Address| a.word() != max.word())
    assert!(!is_pass(o))
    assert!(case_of(o) < 256)
    let z = check(Config::new(fixed_seed(43)), |a: Address| a.word() != 0)
    assert!(!is_pass(z))
    assert!(case_of(z) < 256)
}

#[event]
struct Shape { e0: u256, e1: u256, e2: u256, e3: u256 }

// ---- tuples ----
// (u8, u8): a + b < 10 fails; shrinks to a sum of exactly 10
#[test]
fn tuple2_u8_failing_property_sum_is_10() uses (evm: mut Evm) {
    let o = check(Config::new(fixed_seed(50)), |p: (u8, u8)| (p.0 as u256) + (p.1 as u256) < 10)
    assert!(!is_pass(o))
    let m = shrunk_of(o, (0, 0))
    evm.emit(Shape { e0: m.0 as u256, e1: m.1 as u256, e2: 0, e3: 0 })
    assert!((m.0 as u256) + (m.1 as u256) == 10)
}

#[test]
fn tuple2_passing_property() uses (evm: mut Evm) {
    let g0 = evm.gas()
    let o = check(Config::new(fixed_seed(51)), |p: (u8, u8)| (p.0 as u256) + (p.1 as u256) < 511)
    assert!(is_pass(o))
    assert!(g0 - evm.gas() >= 256 * 50)
}

#[test]
fn tuple3_failing_property_sum_is_10() uses (evm: mut Evm) {
    let o = check(Config::new(fixed_seed(52)), |p: (u8, u16, u32)| (p.0 as u256) + (p.1 as u256) + (p.2 as u256) < 10)
    assert!(!is_pass(o))
    let m = shrunk_of(o, (0, 0, 0))
    evm.emit(Shape { e0: m.0 as u256, e1: m.1 as u256, e2: m.2 as u256, e3: 0 })
    assert!((m.0 as u256) + (m.1 as u256) + (m.2 as u256) == 10)
}

#[test]
fn tuple4_failing_property_sum_is_10() uses (evm: mut Evm) {
    let o = check(Config::new(fixed_seed(53)), |p: (u8, u8, u8, u8)| (p.0 as u256) + (p.1 as u256) + (p.2 as u256) + (p.3 as u256) < 10)
    assert!(!is_pass(o))
    let m = shrunk_of(o, (0, 0, 0, 0))
    evm.emit(Shape { e0: m.0 as u256, e1: m.1 as u256, e2: m.2 as u256, e3: m.3 as u256 })
    assert!((m.0 as u256) + (m.1 as u256) + (m.2 as u256) + (m.3 as u256) == 10)
}

#[test]
fn tuple3_passing_property() uses (evm: mut Evm) {
    let g0 = evm.gas()
    let o = check(Config::new(fixed_seed(54)), |p: (bool, u8, Address)| (p.1 as u256) < 256)
    assert!(is_pass(o))
    assert!(g0 - evm.gas() >= 256 * 50)
}

// ---- arrays ----
// [u64; 4]: sum < 10 fails. The shrinker tries element 0's candidates first, then 1's, ...;
// observed minimal shape (logged in `Shape`): [0, 0, 0, 10], i.e. the whole 10 sits in the last element.
#[test]
fn array_u64x4_failing_property_sum_is_10() uses (evm: mut Evm) {
    let o = check(Config::new(fixed_seed(60)), |a: [u64; 4]| (a[0] as u256) + (a[1] as u256) + (a[2] as u256) + (a[3] as u256) < 10)
    assert!(!is_pass(o))
    let m = shrunk_of(o, [0, 0, 0, 0])
    evm.emit(Shape { e0: m[0] as u256, e1: m[1] as u256, e2: m[2] as u256, e3: m[3] as u256 })
    assert!((m[0] as u256) + (m[1] as u256) + (m[2] as u256) + (m[3] as u256) == 10)
}

#[test]
fn array_passing_property() uses (evm: mut Evm) {
    let g0 = evm.gas()
    let o = check(Config::new(fixed_seed(61)), |a: [u8; 3]| (a[0] as u256) + (a[1] as u256) + (a[2] as u256) < 766)
    assert!(is_pass(o))
    assert!(g0 - evm.gas() >= 256 * 50)
}

// ---- user struct: copy this pattern for your own types ----
/// A user-defined struct becomes testable by delegating Arbitrary, Shrink and Encode to a tuple of its
/// fields. To copy: (1) `impl Copy for YourStruct {}`; (2) convert to/from a tuple of the fields;
/// (3) call the tuple's impls generically, as `<(A, B) as Arbitrary>::arbitrary(mut rng)` (never `Type::f`).
struct Transfer { to: Address, amount: u256 }
impl Copy for Transfer {}

fn transfer_of(_ p: (Address, u256)) -> Transfer { Transfer { to: p.0, amount: p.1 } }
fn pair_of(_ t: Transfer) -> (Address, u256) { (t.to, t.amount) }

impl Arbitrary for Transfer {
    fn arbitrary<R: qc::Rng>(_ rng: mut R) -> Self {
        transfer_of(<(Address, u256) as Arbitrary>::arbitrary(mut rng))
    }
}

impl Shrink for Transfer {
    fn shrink_step(self, _ i: u256) -> Option<Self> {
        match pair_of(self).shrink_step(i) {
            Option::Some(p) => Option::Some(transfer_of(p))
            Option::None => Option::None
        }
    }
}

impl Encode for Transfer {
    fn words(self) -> DynArray<u256> { pair_of(self).words() }
}

// amount <= 500 fails for amount 501; `to` is irrelevant so it shrinks to the zero address
#[test]
fn transfer_failing_property_shrinks_to_501_and_zero_address() uses (evm: mut Evm) {
    let o = check(Config::new(fixed_seed(70)), |t: Transfer| t.amount <= 500)
    assert!(!is_pass(o))
    let m = shrunk_of(o, Transfer { to: Address::zero(), amount: 0 })
    assert!(m.amount == 501)
    assert!(m.to.word() == 0)
}

#[test]
fn transfer_passing_property() uses (evm: mut Evm) {
    let g0 = evm.gas()
    let o = check(Config::new(fixed_seed(71)), |t: Transfer| t.to.word() < 1461501637330902918203684832716283019655932542976)
    assert!(is_pass(o))
    assert!(g0 - evm.gas() >= 256 * 50)
}

// ---- Encode: composites report in full (no truncation at 4 words) ----
#[test]
fn encode_composites_report_all_words() uses (evm: mut Evm) {
    let a: [u64; 6] = [1, 2, 3, 4, 5, 6]
    let w = a.words()
    assert!(w.len() == 6)
    assert!(w.get(5) == 6)
    let w2 = (7 as u8, true, Address::from_word_truncate(9), 10 as u256).words()
    assert!(w2.len() == 4)
    assert!(w2.get(0) == 7 && w2.get(1) == 1 && w2.get(2) == 9 && w2.get(3) == 10)
}

// PropertyFailed carries all 6 words of an array counterexample
#[test(should_revert, selector = 0x4c350703)]
fn revert_reports_array_counterexample() uses (evm: mut Evm) {
    assert_holds(check(Config::new(fixed_seed(72)), |a: [u64; 6]| (a[0] as u256) + (a[5] as u256) < 10))
}
