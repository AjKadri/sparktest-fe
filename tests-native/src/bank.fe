// Bank model tests (native): the planted bug needs 3 commands; the fixed bank passes.
use sparktest::{check, Config, Outcome, Seq, Index, Tally}
use sparktest_native::fixed_seed

#[test]
fn bank_bug_is_found_and_shrunk_to_three_commands() {
    match check(
        Config::new(fixed_seed(960)).with_cases(512),
        props::prop_bank_sequence,
    ) {
        Outcome::Pass { cases: _ } => {
            assert!(false)
        },
        Outcome::Fail { original, shrunk, case: _, seed: _, steps: _, early: _ } => {
            assert!(original.len > 3)
            assert!(shrunk.len == 3)
            // deposit, withdraw, deposit; amounts 1; one account throughout; the unused `b` is 0
            assert!(
                shrunk.items[0].0.value == 0
                    && shrunk.items[1].0.value == 1
                    && shrunk.items[2].0.value == 0,
            )
            assert!(
                shrunk.items[0].3 == 1 && shrunk.items[1].3 == 1 && shrunk.items[2].3 == 1,
            )
            assert!(
                shrunk.items[0].1.value == shrunk.items[1].1.value
                    && shrunk.items[1].1.value == shrunk.items[2].1.value,
            )
            assert!(
                shrunk.items[0].2.value == 0
                    && shrunk.items[1].2.value == 0
                    && shrunk.items[2].2.value == 0,
            )
        },
    }
}

// evaluates `props::prop_bank_fixed` and records the evaluation: the test asserts the exact number of evaluations
fn counted_bank_fixed(_ s: Seq<(Index<3>, Index<3>, Index<3>, u16), 8>) -> bool
uses (tally: mut Tally)
{
    tally.call(true)
    props::prop_bank_fixed(s)
}

#[test]
fn bank_fixed_passes() {
    var tally = Tally::new()
    match with (mut tally) {
        check(
            Config::new(fixed_seed(961)).with_cases(100000),
            counted_bank_fixed,
        )
    } {
        Outcome::Pass { cases } => {
            assert!(cases == 100000)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            assert!(false)
        },
    }
    // exact proof of work: the property was evaluated once per case, 100000 times
    assert!(tally.attempted == 100000)
}

// the same Config (seed 960, 512 cases) that finds the planted bug passes on the fixed bank; the exact evaluation count proves the cases ran
#[test]
fn bank_fixed_passes_the_seed_that_broke_the_bug() {
    var tally = Tally::new()
    match with (mut tally) {
        check(
            Config::new(fixed_seed(960)).with_cases(512),
            counted_bank_fixed,
        )
    } {
        Outcome::Pass { cases } => {
            assert!(cases == 512)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            assert!(false)
        },
    }
    assert!(tally.attempted == 512)
}
