// L9 std hunt on native (docs/EXPECTATIONS.md, section "L9"): properties over std/core APIs, all predicted to PASS.
use sparktest::{check, Config, Outcome, summarize}
use sparktest_native::fixed_seed

#[test]
fn hunt_a_hashmap_spread_keys_matches_the_model() {
    let s = summarize(
        check(
            Config::new(fixed_seed(9101)).with_cases(64),
            props::prop_hunt_hashmap_spread_keys,
        ),
    )
    assert!(s.failed == 0)
}

