// Index<N> tests (native): bounded, edge-biased, roughly uniform, shrinks to the boundary of the failing set.
use sparktest::{check, Config, Outcome, Index, Arbitrary, Encode, Xorshift}
use sparktest_native::fixed_seed

fn fails_below_3(_ i: Index<10>) -> bool { i.value < 3 }

#[test]
fn index_values_stay_below_n_and_hit_both_edges() {
    var rng = Xorshift::seeded(fixed_seed(900))
    var saw0 = false
    var sawmax = false
    var n: u256 = 0
    while n < 256 {
        let v = <Index<4> as Arbitrary>::arbitrary(mut rng)
        assert!(v.value < 4)
        if v.value == 0 { saw0 = true }
        if v.value == 3 { sawmax = true }
        n += 1
    }
    assert!(saw0 && sawmax)
}

#[test]
fn index_large_n_stays_in_range_and_hits_edges() {
    var rng = Xorshift::seeded(fixed_seed(901))
    var saw0 = false
    var sawmax = false
    var n: u256 = 0
    while n < 256 {
        let v = <Index<1000> as Arbitrary>::arbitrary(mut rng)
        assert!(v.value < 1000)
        if v.value == 0 { saw0 = true }
        if v.value == 999 { sawmax = true }
        n += 1
    }
    assert!(saw0 && sawmax)
}

#[test]
fn index_n_equals_1_is_always_zero() {
    var rng = Xorshift::seeded(fixed_seed(902))
    var n: u256 = 0
    while n < 64 {
        assert!(<Index<1> as Arbitrary>::arbitrary(mut rng).value == 0)
        n += 1
    }
}

// 1000 draws of Index<4>: the middle values are drawn uniformly, so each shows up plenty of times (proof the loop ran: counts sum to 1000)
#[test]
fn index_draws_are_spread_over_the_whole_range() {
    var rng = Xorshift::seeded(fixed_seed(903))
    var c0: u256 = 0
    var c1: u256 = 0
    var c2: u256 = 0
    var c3: u256 = 0
    var n: u256 = 0
    while n < 1000 {
        let v = <Index<4> as Arbitrary>::arbitrary(mut rng).value
        if v == 0 { c0 += 1 }
        if v == 1 { c1 += 1 }
        if v == 2 { c2 += 1 }
        if v == 3 { c3 += 1 }
        n += 1
    }
    assert!(c0 + c1 + c2 + c3 == 1000)
    assert!(c0 >= 100 && c1 >= 100 && c2 >= 100 && c3 >= 100)
}

#[test]
fn index_shrinks_to_the_boundary_of_the_failing_set() {
    match check(Config::new(fixed_seed(904)), fails_below_3) {
        Outcome::Pass { cases: _ } => { assert!(false) }
        Outcome::Fail { original, shrunk, case: _, seed: _, steps: _, early: _ } => {
            assert!(original.value >= 3)
            assert!(shrunk.value == 3)
        }
    }
}

#[test]
fn index_encodes_as_one_word() {
    let i: Index<8> = Index { value: 5 }
    let w = i.words()
    assert!(w.len() == 1)
    assert!(w.get(0) == 5)
}
