use std::io::Stdout
use sparktest::{check, Config, Outcome, Checked, MAX, Tally}
use sparktest_native::{assert_holds, fixed_seed, opaque_zero}

struct Info {
    failed: bool,
    original: u256,
    shrunk: u256,
    case: u256,
    steps: u256,
    cases: u256,
    seed: u256,
}

fn info(_ o: Outcome<u256>) -> Info {
    match o {
        Outcome::Pass { cases } => Info {
            failed: false,
            original: 0,
            shrunk: 0,
            case: 0,
            steps: 0,
            cases,
            seed: 0,
        },
        Outcome::Fail { original, shrunk, case, seed, steps, early: _ } => Info {
            failed: true,
            original,
            shrunk,
            case,
            steps,
            cases: 0,
            seed,
        },
    }
}

#[test]
fn a_shrinks_to_1000() {
    let i = info(check(Config::new(fixed_seed(1)), props::prop_below_1000))
    assert!(i.failed)
    assert!(i.shrunk == 1000)
    assert!(i.original >= 1000)
}

#[test]
fn b_holding_property_passes_all_cases() {
    // x/2 <= x always holds; `x != s` (s opaque) keeps the loop observable to the optimizer
    let s = fixed_seed(2)
    let i = info(check(Config::new(s), |x: u256| x / 2 <= x && x != s))
    assert!(!i.failed)
    assert!(i.cases == 256)
}

#[test]
fn c_same_seed_same_outcome_different_seed_differs() {
    let s = fixed_seed(3)
    let a = info(check(Config::new(s), props::prop_below_1000))
    let b = info(check(Config::new(s), props::prop_below_1000))
    assert!(a.failed && b.failed)
    assert!(a.original == b.original)
    assert!(a.shrunk == b.shrunk)
    assert!(a.case == b.case)
    assert!(a.steps == b.steps)
    let c = info(check(Config::new(s + 1), props::prop_below_1000))
    assert!(c.failed)
    assert!(c.original != a.original)
}

// Seed salt 4 is known to draw MAX at case 5 (EdgeProbe event), well inside the 256 cases.
#[test]
fn d_edge_bias_finds_max() {
    let i = info(check(Config::new(fixed_seed(4)), props::prop_ne_max))
    assert!(i.failed)
    assert!(i.original == MAX)
    assert!(i.shrunk == MAX)
    assert!(i.case < 256)
}

#[test]
fn e1_zero_cases_passes_with_zero() {
    let i = info(
        check(
            Config::new(fixed_seed(5)).with_cases(0),
            props::prop_false,
        ),
    )
    assert!(!i.failed)
    assert!(i.cases == 0)
}

#[test]
fn e2_zero_max_shrinks_keeps_original() {
    let i = info(
        check(
            Config::new(fixed_seed(6)).with_max_shrinks(0),
            props::prop_below_1000,
        ),
    )
    assert!(i.failed)
    assert!(i.steps == 0)
    assert!(i.shrunk == i.original)
}

#[test]
fn e3_always_false_shrinks_to_zero() {
    let i = info(check(Config::new(fixed_seed(7)), props::prop_false))
    assert!(i.failed)
    assert!(i.shrunk == 0)
    assert!(i.case == 0)
}

// `x != s`, recording the evaluation: the tests assert exact evaluation counts
fn counted_ne(_ x: u256, _ s: u256) -> bool uses (tally: mut Tally) {
    tally.call(true)
    x != s
}

// the loop really ran: 2000 cases evaluate the property exactly 2000 times, 100000 cases exactly 100000 times
#[test]
fn f_evaluations_equal_the_cases() {
    let s = fixed_seed(8)
    var t1 = Tally::new()
    var t2 = Tally::new()
    let a = info(
        with (mut t1) {
            check(
                Config::new(s).with_cases(2000),
                |x: u256| counted_ne(x, s),
            )
        },
    )
    let b = info(
        with (mut t2) {
            check(
                Config::new(s).with_cases(100000),
                |x: u256| counted_ne(x, s),
            )
        },
    )
    assert!(!a.failed && !b.failed)
    assert!(b.cases == 100000)
    assert!(t1.attempted == 2000)
    assert!(t2.attempted == 100000)
}

#[test]
fn g_bool_shrinks_to_true() {
    match check(Config::new(fixed_seed(9)), props::prop_bool_false) {
        Outcome::Pass { cases: _ } => {
            assert!(false)
        },
        Outcome::Fail { original, shrunk, case: _, seed: _, steps: _, early: _ } => {
            assert!(original == true)
            assert!(shrunk == true)
        },
    }
}

// Native only checks that assert_holds reverts on a failing property: any revert passes, the selector is not checked here.
// The sonatina twin in tests-evm checks the selector 0x4c350703 = PropertyFailed(uint256,uint256,uint256,uint256[]).
#[test(should_revert)]
fn h_assert_holds_reverts_on_a_failing_property_any_reason()
uses (out: mut Stdout)
{
    assert_holds(check(Config::new(fixed_seed(10)), props::prop_below_1000))
}

#[test]
fn i_replay_reproduces_failure() {
    let o = info(check(Config::new(fixed_seed(11)), props::prop_below_1000))
    assert!(o.failed)
    // replaying with the seed reported in the Outcome gives the same original, shrunk, case
    let r = info(check(Config::new(o.seed), props::prop_below_1000))
    assert!(r.failed)
    assert!(r.original == o.original)
    assert!(r.shrunk == o.shrunk)
    assert!(r.case == o.case)
    assert!(r.steps == o.steps)
}

// Step 2 probe: a property that overflows on some case makes the WHOLE test revert with Panic(0x11);
// check() cannot catch it, and no Outcome is produced.
#[test(should_revert, panic = 0x11)]
fn probe_overflow_in_property_reverts_whole_run() {
    let o = info(
        check(Config::new(fixed_seed(12)), props::prop_overflows_at_max),
    )
    assert!(
        !o.failed,
    ) // never reached when some case is MAX or the generator yields it
}

// checked_add/sub/mul boundaries: `z` is an opaque zero (chain id compared against an impossible value),
// so the helpers run at runtime. props::checked_boundaries returns 0 when every boundary is right,
// otherwise the number of the first wrong case.
#[test]
fn checked_helpers_boundaries() {
    assert!(props::checked_boundaries(opaque_zero()) == 0)
}

// the checked helpers never panic where plain `+` would: max + 1 as Option
#[test]
fn checked_add_none_instead_of_panic() {
    let m: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff - opaque_zero()
    assert!(m.checked_add(1).is_none())
    assert!(!m.checked_sub(1).is_none())
}

// 1M cases: the property is evaluated exactly 1,000,000 times (the wall time is the PASS line's duration; bench-native prints timing)
#[test]
fn million_cases_native() {
    let s = fixed_seed(99)
    var tally = Tally::new()
    let o = info(
        with (mut tally) {
            check(
                Config::new(s).with_cases(1000000),
                |x: u256| counted_ne(x, s),
            )
        },
    )
    assert!(!o.failed)
    assert!(o.cases == 1000000)
    assert!(tally.attempted == 1000000)
}
