// ---- u8 ----
#[test]
fn u8_passing_property() {
    var tally = Tally::new()
    let o = with (mut tally) {
        check(
            Config::new(fixed_seed(20)).with_cases(100000),
            counted_prop_u8_any,
        )
    }
    assert!(is_pass(o))
    assert!(case_of(o) == 100000)
    // proof the cases actually ran: gas used is at least 50 per case
    // exact proof of work: the property was evaluated once per case, 100000 times
    assert!(tally.attempted == 100000)
}

// x < 200 fails; the minimal counterexample is exactly 200
#[test]
fn u8_failing_property_shrinks_to_minimum() {
    let o = check(Config::new(fixed_seed(21)), props::prop_u8_below_lim)
    assert!(!is_pass(o))
    assert!((shrunk_of(o, 0) as u256) == 200)
}

// edge bias: the max value is found within 256 cases
#[test]
fn u8_edge_bias_finds_max() {
    let max: u8 = 255
    let o = check(Config::new(fixed_seed(22)), props::prop_u8_ne_max)
    assert!(!is_pass(o))
    assert!(case_of(o) < 256)
    assert!(shrunk_of(o, 0) == max)
}

