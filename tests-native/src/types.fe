}

// amount <= 500 fails for amount 501; `to` is irrelevant so it shrinks to the zero address
#[test]
fn transfer_failing_property_shrinks_to_501_and_zero_address() {
    let o = check(
        Config::new(fixed_seed(70)),
        props::prop_transfer_amount_le_500,
    )
    assert!(!is_pass(o))
    let m = shrunk_of(o, Transfer { to: Address::zero(), amount: 0 })
    assert!(m.amount == 501)
    assert!(m.to.word() == 0)
}

#[test]
fn transfer_passing_property() {
