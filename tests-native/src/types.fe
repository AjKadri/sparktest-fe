// L1 tests: one passing and one failing property per type; every seed is fixed via fixed_seed(salt).
use std::evm::Address
use std::io::Stdout
use std::abi::DynArray
use sparktest::{check, Config, Outcome, Arbitrary, Shrink, Encode, Tally}
use sparktest_native::{assert_holds, fixed_seed}
use props::Transfer

fn is_pass<T>(_ o: Outcome<T>) -> bool {
    match o {
        Outcome::Pass { cases: _ } => true,
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => false,
    }
}

fn shrunk_of<T: Copy>(_ o: Outcome<T>, _ d: T) -> T {
    match o {
        Outcome::Pass { cases: _ } => d,
        Outcome::Fail { original: _, shrunk, case: _, seed: _, steps: _, early: _ } => shrunk,
    }
}

fn case_of<T>(_ o: Outcome<T>) -> u256 {
    match o {
        Outcome::Pass { cases } => cases,
        Outcome::Fail { original: _, shrunk: _, case, seed: _, steps: _, early: _ } => case,
    }
}

// evaluates `props::prop_u8_any` and records the evaluation: the test asserts the exact number of evaluations
fn counted_prop_u8_any(_ x: u8) -> bool uses (tally: mut Tally) {
    tally.call(true)
    props::prop_u8_any(x)
}

