        )
    }
    assert!(is_pass(o))
    // exact proof of work: the property was evaluated once per case, 100000 times
    assert!(tally.attempted == 100000)
}

// ---- Encode: composites report in full (no truncation at 4 words) ----
#[test]
fn encode_composites_report_all_words() {
    let a: [u64; 6] = [1, 2, 3, 4, 5, 6]
    let w = a.words()
    assert!(w.len() == 6)
    assert!(w.get(5) == 6)
    let w2 = (7 as u8, true, Address::from_word_truncate(9), 10 as u256).words()
    assert!(w2.len() == 4)
    assert!(
        w2.get(0) == 7 && w2.get(1) == 1 && w2.get(2) == 9 && w2.get(3) == 10,
    )
}

// PropertyFailed carries all 6 words of an array counterexample
#[test(should_revert)]
fn revert_reports_array_counterexample() uses (out: mut Stdout) {
    assert_holds(
        check(
            Config::new(fixed_seed(72)),
            props::prop_arr_u64x6_ends_lt_10,
        ),
    )
}
