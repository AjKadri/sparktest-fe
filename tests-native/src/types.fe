// word(a) < 0x1000 fails; minimal counterexample is the address 0x1000
#[test]
fn address_failing_property_shrinks_to_minimum() {
    let o = check(Config::new(fixed_seed(41)), props::prop_addr_below_0x1000)
    assert!(!is_pass(o))
    assert!(shrunk_of(o, Address::zero()).word() == 0x1000)
}

// edge bias: the max address (2^160 - 1) and the zero address are found
#[test]
fn address_edge_bias_finds_max_and_zero() {
    let max = Address::from_word_truncate(1461501637330902918203684832716283019655932542975)
    let o = check(Config::new(fixed_seed(42)), props::prop_addr_ne_max)
    assert!(!is_pass(o))
    assert!(case_of(o) < 256)
    let z = check(Config::new(fixed_seed(43)), props::prop_addr_ne_zero)
    assert!(!is_pass(z))
    assert!(case_of(z) < 256)
}

// ---- tuples ----
// (u8, u8): a + b < 10 fails; shrinks to a sum of exactly 10
#[test]
fn tuple2_u8_failing_property_sum_is_10() {
    let o = check(Config::new(fixed_seed(50)), props::prop_pair_u8_sum_lt_10)
    assert!(!is_pass(o))
    let m = shrunk_of(o, (0, 0))
    assert!((m.0 as u256) + (m.1 as u256) == 10)
}

#[test]
fn tuple2_passing_property() {
    var tally = Tally::new()
    let o = with (mut tally) {
        check(
            Config::new(fixed_seed(51)).with_cases(100000),
            counted_prop_pair_u8_sum_lt_511,
        )
    }
    assert!(is_pass(o))
    // exact proof of work: the property was evaluated once per case, 100000 times
    assert!(tally.attempted == 100000)
}

#[test]
fn tuple3_failing_property_sum_is_10() {
    let o = check(Config::new(fixed_seed(52)), props::prop_triple_sum_lt_10)
    assert!(!is_pass(o))
    let m = shrunk_of(o, (0, 0, 0))
    assert!((m.0 as u256) + (m.1 as u256) + (m.2 as u256) == 10)
}

#[test]
fn tuple4_failing_property_sum_is_10() {
