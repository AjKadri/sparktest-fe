// Native executable that prints the 11 cross-check scenarios (see scripts/cross-check.sh).
use std::io::Stdout
use sparktest::{Config, check, full, Outcome}
use sparktest_native::{opaque_zero, print_summary, print_full}
use props::{
    scenario_u256_below_1000,
    scenario_pair_u8_sum,
    scenario_arr_u64x4_sum,
    scenario_addr_below_0x1000,
    scenario_transfer_amount,
    scenario_late_fail,
    scenario_digest,
    scenario_demo_capped_mint,
    scenario_demo_buggy_sort,
    scenario_demo_pair_sum,
    scenario_demo_saturating_add,
    DEMO_SEED_CAPPED_MINT,
    DEMO_SEED_BUGGY_SORT,
    DEMO_SEED_PAIR_SUM,
    DEMO_SEED_SATURATING_ADD,
    DEMO_SEED_BANK,
    DEMO_SEED_PANIC,
}

// the fixed demo properties: prints the number of cases that passed (XP lines; scripts/build_demo.py reads them)
fn print_pass(_ name: String<31>, _ cases: u256, _ failed: u256)
uses (out: mut Stdout)
{
    println!("XP ", name, " failed=", failed, " cases=", cases)
}

pub fn main() -> i32 uses (out: mut Stdout) {
    let z = opaque_zero()
    print_summary("u256_below_1000", scenario_u256_below_1000(1001 + z))
    print_summary("pair_u8_sum", scenario_pair_u8_sum(1002 + z))
    print_summary("arr_u64x4_sum", scenario_arr_u64x4_sum(1003 + z))
    print_summary("addr_below_0x1000", scenario_addr_below_0x1000(1004 + z))
    print_summary("transfer_amount", scenario_transfer_amount(1005 + z))
    print_summary("late_fail", scenario_late_fail(2004 + z))
    print_summary("digest", scenario_digest(2100 + z))
    print_summary(
        "demo_capped_mint",
        scenario_demo_capped_mint(DEMO_SEED_CAPPED_MINT + z),
    )
    print_summary(
        "demo_buggy_sort",
        scenario_demo_buggy_sort(DEMO_SEED_BUGGY_SORT + z),
    )
    print_summary(
        "demo_pair_sum",
        scenario_demo_pair_sum(DEMO_SEED_PAIR_SUM + z),
    )
    print_summary(
        "demo_saturating_add",
        scenario_demo_saturating_add(DEMO_SEED_SATURATING_ADD + z),
    )
    print_full(
        "demo_bank_sequence",
        full(
            check(
                Config::new(DEMO_SEED_BANK + z),
                props::prop_bank_sequence,
            ),
        ),
    )
    match check(
        Config::new(DEMO_SEED_CAPPED_MINT + z),
        props::prop_capped_mint_fixed,
    ) {
        Outcome::Pass { cases } => {
            print_pass("capped_mint_fixed", cases, 0)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            print_pass("capped_mint_fixed", 0, 1)
        },
    }
    match check(
        Config::new(DEMO_SEED_BUGGY_SORT + z),
        props::prop_sorted_fixed,
    ) {
        Outcome::Pass { cases } => {
            print_pass("buggy_sort_fixed", cases, 0)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            print_pass("buggy_sort_fixed", 0, 1)
        },
    }
    match check(Config::new(DEMO_SEED_BANK + z), props::prop_bank_fixed) {
        Outcome::Pass { cases } => {
            print_pass("bank_sequence_fixed", cases, 0)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            print_pass("bank_sequence_fixed", 0, 1)
        },
    }
    match check(
        Config::new(DEMO_SEED_PANIC + z),
        props::prop_panic_overflow_fixed,
    ) {
        Outcome::Pass { cases } => {
            print_pass("panic_overflow_fixed", cases, 0)
        },
        Outcome::Fail { original: _, shrunk: _, case: _, seed: _, steps: _, early: _ } => {
            print_pass("panic_overflow_fixed", 0, 1)
        },
    }
    0
}
